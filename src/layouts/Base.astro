---
import "../styles/global.css";
import "../styles/playful.css";

type SchemaObject = Record<string, unknown>;

interface Props {
  title: string;
  titleArabic?: string;
  description?: string;
  descriptionArabic?: string;
  /** A page-specific social card; defaults to the homepage one. */
  ogImagePath?: string;
  /** `article` for guides; `website` for everything else. */
  ogType?: "website" | "article";
  /** Keep utility pages out of the index (login, 404, stats). */
  noindex?: boolean;
  /** Page-specific JSON-LD. Organization + WebSite are added globally. */
  schema?: SchemaObject | SchemaObject[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  titleArabic = title,
  description = "Whano automates WhatsApp order confirmation, edits, shipping updates, and reviews for Shopify stores in Egypt, with no number to connect.",
  descriptionArabic = "Whano يؤتمت تأكيد الطلبات وتعديلها وتحديثات الشحن والتقييمات لمتاجر Shopify في مصر، من دون ربط أي رقم.",
  ogImagePath = "/og.png",
  ogType = "website",
  noindex = false,
  schema,
  publishedTime,
  modifiedTime,
} = Astro.props;

// The live edge serves directory URLs with a trailing slash. Keep the
// canonical and the sitemap on that same URL shape.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
const siteRoot = new URL("/", Astro.site);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "NomedaCo",
  alternateName: "Nomeda",
  url: "https://nomeda.tech",
  logo: new URL("/icon-512.png", Astro.site).href,
  sameAs: [
    "https://apps.shopify.com/whano",
    "https://x.com/CoNomeda56945",
    "https://instagram.com/nomeda.tech",
  ],
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Whano",
  url: siteRoot.href,
  inLanguage: ["ar", "en"],
  publisher: { "@type": "Organization", name: "NomedaCo", url: "https://nomeda.tech" },
};
const pageSchemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
---

<!doctype html>
<html
  lang="ar"
  dir="rtl"
  data-language="ar"
  data-title-en={title}
  data-title-ar={titleArabic}
  data-description-en={description}
  data-description-ar={descriptionArabic}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="meta-description" name="description" content={descriptionArabic} />
    <meta name="theme-color" content="#f8faf9" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content="NomedaCo" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={new URL("/sitemap.xml", Astro.site)} />
    <!-- Static preloads are discovered before the stylesheet. Both Readex
         subsets are tiny variable fonts; loading both avoids a late swap on
         pages that mix Arabic and Latin (Whano, EGP, tracking ids). -->
    <link rel="preload" href="/fonts/readex-arabic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/readex-latin.woff2" as="font" type="font/woff2" crossorigin />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta id="meta-og-title" property="og:title" content={titleArabic} />
    <meta id="meta-og-description" property="og:description" content={descriptionArabic} />
    <meta property="og:site_name" content="Whano" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta id="meta-og-image-alt" property="og:image:alt" content={titleArabic} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta id="meta-twitter-title" name="twitter:title" content={titleArabic} />
    <meta id="meta-twitter-description" name="twitter:description" content={descriptionArabic} />
    <meta name="twitter:image" content={ogImage} />
    <meta id="meta-twitter-image-alt" name="twitter:image:alt" content={titleArabic} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{titleArabic}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
    {pageSchemas.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        // A script error should never leave the editorial sections invisible.
        const revealFallback = () => root.classList.remove("js");
        window.addEventListener("error", revealFallback, { once: true });
        window.addEventListener("unhandledrejection", revealFallback, { once: true });
        try {
          // Arabic is the server-rendered default. A saved choice wins; on a
          // first visit, an Arabic browser gets Arabic and anything else gets
          // English, so the page is readable before the first interaction.
          const saved = window.localStorage.getItem("whano-language");
          const language =
            saved === "en" || saved === "ar"
              ? saved
              : (navigator.language || "").toLowerCase().startsWith("ar")
                ? "ar"
                : "en";
          root.dataset.language = language;
          root.lang = language;
          root.dir = language === "ar" ? "rtl" : "ltr";
          const title = language === "ar" ? root.dataset.titleAr : root.dataset.titleEn;
          const description = language === "ar" ? root.dataset.descriptionAr : root.dataset.descriptionEn;
          if (title) document.title = title;
          if (description) {
            document.getElementById("meta-description")?.setAttribute("content", description);
            document.getElementById("meta-og-description")?.setAttribute("content", description);
            document.getElementById("meta-twitter-description")?.setAttribute("content", description);
          }
          if (title) {
            document.getElementById("meta-og-title")?.setAttribute("content", title);
            document.getElementById("meta-twitter-title")?.setAttribute("content", title);
            document.getElementById("meta-og-image-alt")?.setAttribute("content", title);
            document.getElementById("meta-twitter-image-alt")?.setAttribute("content", title);
          }
        } catch {
          // Keep the Arabic default when storage is unavailable.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span data-copy="en">Skip to content</span>
      <span data-copy="ar" lang="ar">تجاوز إلى المحتوى</span>
    </a>
    <slot />
    <script is:inline>
      // First-party, cookieless analytics: one counter per page view and per
      // install/login click. Localhost and privacy signals are ignored.
      (() => {
        const production = /(^|\.)nomeda\.tech$/i.test(location.hostname);
        if (!production || navigator.doNotTrack === "1" || navigator.globalPrivacyControl) return;
        const send = (event) => {
          try {
            const payload = JSON.stringify({ path: location.pathname, event });
            if (navigator.sendBeacon) {
              navigator.sendBeacon("/api/hit", new Blob([payload], { type: "application/json" }));
            } else {
              fetch("/api/hit", { method: "POST", body: payload, keepalive: true });
            }
          } catch {
            // Analytics never breaks the page.
          }
        };
        send("view");
        document.addEventListener("click", (event) => {
          const target = event.target;
          const link =
            target && target.closest ? target.closest("a[data-access-link], a[data-console-link]") : null;
          if (!link) return;
          send(link.hasAttribute("data-console-link") ? "click-login" : "click-install");
        });
      })();
    </script>
    <script is:inline>
      try {
        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.08 });
          document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
        } else {
          document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
        }
      } catch {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
