---
import "../styles/global.css";

interface Props {
  title: string;
  titleArabic?: string;
  description?: string;
  descriptionArabic?: string;
  /** A page-specific social card; defaults to the homepage one. */
  ogImagePath?: string;
}

const {
  title,
  titleArabic = title,
  description = "Whano keeps Shopify orders moving on WhatsApp with clear confirmations, updates, and follow-up.",
  descriptionArabic = "Whano يساعد متاجر Shopify على متابعة الطلبات عبر واتساب بتأكيدات وتحديثات ومتابعة واضحة.",
  ogImagePath = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
---

<!doctype html>
<html lang="ar" dir="rtl" data-language="ar" data-title-en={title} data-title-ar={titleArabic} data-description-en={description} data-description-ar={descriptionArabic}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="meta-description" name="description" content={descriptionArabic} />
    <meta name="theme-color" content="#f8faf9" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta id="meta-og-title" property="og:title" content={titleArabic} />
    <meta id="meta-og-description" property="og:description" content={descriptionArabic} />
    <meta property="og:site_name" content="Whano" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:locale:alternate" content="en_EG" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titleArabic} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta id="meta-twitter-title" name="twitter:title" content={titleArabic} />
    <meta id="meta-twitter-description" name="twitter:description" content={descriptionArabic} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={titleArabic} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{titleArabic}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Whano",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: new URL("/", Astro.site).href,
      image: ogImage.href,
      description,
      publisher: { "@type": "Organization", name: "Nomeda", url: "https://nomeda.tech" },
    })} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        try {
          // A saved choice wins. On a first visit, follow the browser: an
          // Arabic browser gets Arabic, anything else gets English — the
          // toggle still remembers whatever the visitor picks.
          const saved = window.localStorage.getItem("whano-language");
          const language =
            saved === "en" || saved === "ar"
              ? saved
              : (navigator.language || "").toLowerCase().startsWith("ar")
                ? "ar"
                : "en";
          root.dataset.language = language;
          root.lang = language;
          root.dir = language === "ar" ? "rtl" : "ltr";
          const title = language === "ar" ? root.dataset.titleAr : root.dataset.titleEn;
          const description = language === "ar" ? root.dataset.descriptionAr : root.dataset.descriptionEn;
          if (title) document.title = title;
          if (description) {
            document.getElementById("meta-description")?.setAttribute("content", description);
            document.getElementById("meta-og-description")?.setAttribute("content", description);
            document.getElementById("meta-twitter-description")?.setAttribute("content", description);
          }
          if (title) {
            document.getElementById("meta-og-title")?.setAttribute("content", title);
            document.getElementById("meta-twitter-title")?.setAttribute("content", title);
          }
        } catch {
          // Keep English as the safe default when storage is unavailable.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span data-copy="en">Skip to content</span>
      <span data-copy="ar" lang="ar">تجاوز إلى المحتوى</span>
    </a>
    <slot />
    <script is:inline>
      // First-party, cookieless analytics: one counter per page view and per
      // install/login click. No third party, no cookie, nothing to consent to.
      (() => {
        const send = (event) => {
          try {
            const payload = JSON.stringify({ path: location.pathname, event });
            if (navigator.sendBeacon) {
              navigator.sendBeacon("/api/hit", new Blob([payload], { type: "application/json" }));
            } else {
              fetch("/api/hit", { method: "POST", body: payload, keepalive: true });
            }
          } catch {
            // Analytics never breaks the page.
          }
        };
        send("view");
        document.addEventListener("click", (event) => {
          const target = event.target;
          const link =
            target && target.closest ? target.closest("a[data-access-link], a[data-console-link]") : null;
          if (!link) return;
          send(link.hasAttribute("data-console-link") ? "click-login" : "click-install");
        });
      })();
    </script>
    <script is:inline>
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
