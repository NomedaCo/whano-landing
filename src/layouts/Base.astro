---
import "../styles/global.css";

interface Props {
  title: string;
  titleArabic?: string;
  description?: string;
  descriptionArabic?: string;
}

const {
  title,
  titleArabic = title,
  description = "Whano keeps Shopify orders moving on WhatsApp with clear confirmations, updates, and follow-up.",
  descriptionArabic = "Whano بيساعد متاجر Shopify تتابع الطلبات على واتساب بالتأكيدات والتحديثات والمتابعة.",
} = Astro.props;
---

<!doctype html>
<html lang="ar" dir="rtl" data-language="ar" data-title-en={title} data-title-ar={titleArabic} data-description-en={description} data-description-ar={descriptionArabic}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta id="meta-description" name="description" content={descriptionArabic} />
    <meta name="theme-color" content="#f8faf9" />
    <meta property="og:type" content="website" />
    <meta id="meta-og-title" property="og:title" content={titleArabic} />
    <meta id="meta-og-description" property="og:description" content={descriptionArabic} />
    <meta property="og:site_name" content="Whano" />
    <meta property="og:locale" content="en_EG" />
    <meta property="og:locale:alternate" content="ar_EG" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta id="meta-twitter-title" name="twitter:title" content={titleArabic} />
    <meta id="meta-twitter-description" name="twitter:description" content={descriptionArabic} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Alexandria:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{titleArabic}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "Whano",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      description,
    })} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        try {
          const saved = window.localStorage.getItem("whano-language");
          const language = saved === "en" ? "en" : "ar";
          root.dataset.language = language;
          root.lang = language;
          root.dir = language === "ar" ? "rtl" : "ltr";
          const title = language === "ar" ? root.dataset.titleAr : root.dataset.titleEn;
          const description = language === "ar" ? root.dataset.descriptionAr : root.dataset.descriptionEn;
          if (title) document.title = title;
          if (description) {
            document.getElementById("meta-description")?.setAttribute("content", description);
            document.getElementById("meta-og-description")?.setAttribute("content", description);
            document.getElementById("meta-twitter-description")?.setAttribute("content", description);
          }
          if (title) {
            document.getElementById("meta-og-title")?.setAttribute("content", title);
            document.getElementById("meta-twitter-title")?.setAttribute("content", title);
          }
        } catch {
          // Keep English as the safe default when storage is unavailable.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      <span data-copy="en">Skip to content</span>
      <span data-copy="ar" lang="ar">انتقل إلى المحتوى</span>
    </a>
    <slot />
    <script is:inline>
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      } else {
        document.querySelectorAll(".reveal").forEach((element) => element.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
