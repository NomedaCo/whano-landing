---
import { site } from "../data/content";
---

<section class="cta-band">
  <div class="site-frame cta-band__inner">
    <h2>
      <span data-copy="en">{site.cta.title.en}</span>
      <span data-copy="ar" lang="ar">{site.cta.title.ar}</span>
    </h2>
    <div>
      <p class="cta-band__copy">
        <span data-copy="en">{site.cta.body.en}</span>
        <span data-copy="ar" lang="ar">{site.cta.body.ar}</span>
      </p>
      <a href={site.accessUrl.en} data-access-link class="button-light">
        <span data-copy="en">{site.cta.button.en}</span>
        <span data-copy="ar" lang="ar">{site.cta.button.ar}</span>
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
