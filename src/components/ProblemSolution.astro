---
const oldWay = [
  "You reply to every order manually",
  "Customers wait hours for confirmation",
  "You forget to ask for reviews",
  "Upsell opportunities slip away",
  "Order modifications need phone calls",
];

const newWay = [
  "Orders confirmed instantly via WhatsApp",
  "Customers get confirmation in their language",
  "Reviews collected automatically after delivery",
  "AI suggests products based on real data",
  "Customers modify orders by texting back",
];
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="text-center mb-16 reveal">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-4 tracking-tight">
        The old way vs. the Whano way
      </h2>
      <p class="text-lg text-text-secondary max-w-2xl mx-auto">
        Manual replies don't scale. Your customers deserve faster responses.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Old Way -->
      <div class="reveal">
        <div class="p-8 rounded-xl border border-border bg-bg-surface h-full">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-error/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h3 class="font-heading text-lg font-semibold text-text-primary">The old way</h3>
          </div>
          <ul class="space-y-3">
            {oldWay.map((item) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-error/60 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 12H6" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- New Way -->
      <div class="reveal">
        <div class="p-8 rounded-xl border border-accent/20 bg-accent/5 h-full">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="font-heading text-lg font-semibold text-text-primary">The Whano way</h3>
          </div>
          <ul class="space-y-3">
            {newWay.map((item) => (
              <li class="flex items-start gap-3 text-text-secondary">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
