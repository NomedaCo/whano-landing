---
import { site } from "../data/content";
---

<header
  id="site-header"
  class="site-header"
  data-access-url-en={site.accessUrl.en}
  data-access-url-ar={site.accessUrl.ar}
  data-switch-ar-en={site.nav.switchToArabic.en}
  data-switch-en-ar={site.nav.switchToEnglish.ar}
  data-menu-open-en={site.nav.menuOpen.en}
  data-menu-open-ar={site.nav.menuOpen.ar}
  data-menu-close-en={site.nav.menuClose.en}
  data-menu-close-ar={site.nav.menuClose.ar}
>
  <div class="site-frame site-header__inner">
    <div class="site-header__brand">
      <a href="/#top" class="wordmark">
        <span class="wordmark__mark" aria-hidden="true"></span>
        whano
      </a>
      <span class="header-context">
        <span data-copy="en">Shopify × WhatsApp</span>
        <span data-copy="ar" lang="ar">Shopify × واتساب</span>
      </span>
    </div>

    <nav class="nav-links" data-primary-nav aria-label="Primary navigation">
      {site.nav.links.map((link) => (
        <a href={`/${link.href}`} class="nav-link">
          <span data-copy="en">{link.label.en}</span>
          <span data-copy="ar" lang="ar">{link.label.ar}</span>
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button id="language-toggle" class="language-toggle" type="button" aria-label="التبديل إلى الإنجليزية" aria-pressed="true">
        <span data-copy="en">{site.nav.language.en}</span>
        <span data-copy="ar" lang="ar">{site.nav.language.ar}</span>
      </button>
      <a href={site.accessUrl.en} data-access-link class="header-cta">
        <svg width="14" height="16" viewBox="0 0 109.5 124.5" fill="currentColor" class="shopify-btn-icon" aria-hidden="true">
          <path d="M74.7,14.8c0,0-1.4,0.4-3.7,1.1c-0.4-1.3-1-2.8-1.8-4.4c-2.6-5-6.5-7.7-11.1-7.7c0,0,0,0,0,0 c-0.3,0-0.6,0-1,0.1c-0.1-0.2-0.3-0.3-0.4-0.5c-2-2.2-4.6-3.2-7.7-3.1c-6,0.2-12,4.5-16.8,12.2c-3.4,5.4-6,12.2-6.7,17.5 c-6.9,2.1-11.7,3.6-11.8,3.7c-3.5,1.1-3.6,1.2-4,4.5C9.1,40.7,0,111.2,0,111.2l75.6,13.1V14.6C75.2,14.7,74.9,14.7,74.7,14.8z M57.2,20.2c-4,1.2-8.4,2.6-12.7,3.9c1.2-4.7,3.6-9.4,6.4-12.5c1.1-1.1,2.6-2.4,4.3-3.2C56.9,12,57.3,16.9,57.2,20.2z M49.1,4.3 c1.4,0,2.6,0.3,3.6,0.9c-1.6,0.8-3.2,2.1-4.7,3.6c-3.8,4.1-6.7,10.5-7.9,16.6c-3.6,1.1-7.2,2.2-10.5,3.2 C31.7,19.1,39.8,4.6,49.1,4.3z M37.4,59.3c0.4,6.4,17.3,7.8,18.3,22.9c0.7,11.9-6.3,20-16.4,20.6c-12.2,0.8-18.9-6.4-18.9-6.4 l2.6-11c0,0,6.7,5.1,12.1,4.7c3.5-0.2,4.8-3.1,4.7-5.1c-0.5-8.4-14.3-7.9-15.2-21.7C23.8,51.8,31.4,40.1,48.2,39 c6.5-0.4,9.8,1.2,9.8,1.2l-3.8,14.4c0,0-4.3-2-9.4-1.6C37.4,53.5,37.3,58.2,37.4,59.3z M61.2,19c0-3-0.4-7.3-1.8-10.9 c4.6,0.9,6.8,6,7.8,9.1C65.4,17.7,63.4,18.3,61.2,19z"/>
          <path d="M78.1,123.9l31.4-7.8c0,0-13.5-91.3-13.6-91.9c-0.1-0.6-0.6-1-1.1-1c-0.5,0-9.3-0.2-9.3-0.2s-5.4-5.2-7.4-7.2 V123.9z"/>
        </svg>
        <span data-copy="en">{site.nav.cta.en}</span>
        <span data-copy="ar" lang="ar">{site.nav.cta.ar}</span>
      </a>
    </div>

    <button id="menu-button" class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav site-frame" data-primary-nav aria-label="Mobile navigation">
    {site.nav.links.map((link) => (
      <a href={`/${link.href}`} class="nav-link">
        <span data-copy="en">{link.label.en}</span>
        <span data-copy="ar" lang="ar">{link.label.ar}</span>
      </a>
    ))}
    <a href={site.accessUrl.en} data-access-link class="header-cta">
      <svg width="14" height="16" viewBox="0 0 109.5 124.5" fill="currentColor" class="shopify-btn-icon" aria-hidden="true">
        <path d="M74.7,14.8c0,0-1.4,0.4-3.7,1.1c-0.4-1.3-1-2.8-1.8-4.4c-2.6-5-6.5-7.7-11.1-7.7c0,0,0,0,0,0 c-0.3,0-0.6,0-1,0.1c-0.1-0.2-0.3-0.3-0.4-0.5c-2-2.2-4.6-3.2-7.7-3.1c-6,0.2-12,4.5-16.8,12.2c-3.4,5.4-6,12.2-6.7,17.5 c-6.9,2.1-11.7,3.6-11.8,3.7c-3.5,1.1-3.6,1.2-4,4.5C9.1,40.7,0,111.2,0,111.2l75.6,13.1V14.6C75.2,14.7,74.9,14.7,74.7,14.8z M57.2,20.2c-4,1.2-8.4,2.6-12.7,3.9c1.2-4.7,3.6-9.4,6.4-12.5c1.1-1.1,2.6-2.4,4.3-3.2C56.9,12,57.3,16.9,57.2,20.2z M49.1,4.3 c1.4,0,2.6,0.3,3.6,0.9c-1.6,0.8-3.2,2.1-4.7,3.6c-3.8,4.1-6.7,10.5-7.9,16.6c-3.6,1.1-7.2,2.2-10.5,3.2 C31.7,19.1,39.8,4.6,49.1,4.3z M37.4,59.3c0.4,6.4,17.3,7.8,18.3,22.9c0.7,11.9-6.3,20-16.4,20.6c-12.2,0.8-18.9-6.4-18.9-6.4 l2.6-11c0,0,6.7,5.1,12.1,4.7c3.5-0.2,4.8-3.1,4.7-5.1c-0.5-8.4-14.3-7.9-15.2-21.7C23.8,51.8,31.4,40.1,48.2,39 c6.5-0.4,9.8,1.2,9.8,1.2l-3.8,14.4c0,0-4.3-2-9.4-1.6C37.4,53.5,37.3,58.2,37.4,59.3z M61.2,19c0-3-0.4-7.3-1.8-10.9 c4.6,0.9,6.8,6,7.8,9.1C65.4,17.7,63.4,18.3,61.2,19z"/>
        <path d="M78.1,123.9l31.4-7.8c0,0-13.5-91.3-13.6-91.9c-0.1-0.6-0.6-1-1.1-1c-0.5,0-9.3-0.2-9.3-0.2s-5.4-5.2-7.4-7.2 V123.9z"/>
      </svg>
      <span data-copy="en">{site.nav.cta.en}</span>
      <span data-copy="ar" lang="ar">{site.nav.cta.ar}</span>
    </a>
  </nav>
</header>

<span id="language-status" class="sr-only" aria-live="polite"></span>

<script>
  const header = document.getElementById("site-header");
  const languageToggle = document.getElementById("language-toggle");
  const menuButton = document.getElementById("menu-button");
  const mobileNav = document.getElementById("mobile-nav");
  const ui = {
    accessUrlEn: header?.dataset.accessUrlEn || "",
    accessUrlAr: header?.dataset.accessUrlAr || "",
    switchToArabic: header?.dataset.switchArEn || "Switch to Arabic",
    switchToEnglish: header?.dataset.switchEnAr || "التبديل إلى الإنجليزية",
    menuOpenEn: header?.dataset.menuOpenEn || "Open menu",
    menuOpenAr: header?.dataset.menuOpenAr || "افتح القائمة",
    menuCloseEn: header?.dataset.menuCloseEn || "Close menu",
    menuCloseAr: header?.dataset.menuCloseAr || "اقفل القائمة",
  };

  let mobileMenuOpen = false;

  function setLanguage(language: "en" | "ar", announce = true) {
    document.documentElement.dataset.language = language;
    document.documentElement.lang = language;
    document.documentElement.dir = language === "ar" ? "rtl" : "ltr";
    languageToggle?.setAttribute("aria-pressed", String(language === "ar"));
    languageToggle?.setAttribute("aria-label", language === "en" ? ui.switchToArabic : ui.switchToEnglish);
    const title = language === "ar"
      ? document.documentElement.dataset.titleAr
      : document.documentElement.dataset.titleEn;
    const description = language === "ar"
      ? document.documentElement.dataset.descriptionAr
      : document.documentElement.dataset.descriptionEn;
    if (title) {
      document.title = title;
      document.getElementById("meta-og-title")?.setAttribute("content", title);
      document.getElementById("meta-twitter-title")?.setAttribute("content", title);
    }
    if (description) {
      document.getElementById("meta-description")?.setAttribute("content", description);
      document.getElementById("meta-og-description")?.setAttribute("content", description);
      document.getElementById("meta-twitter-description")?.setAttribute("content", description);
    }

    document.querySelectorAll("[data-access-link]").forEach((link) => {
      link.setAttribute("href", language === "ar" ? ui.accessUrlAr : ui.accessUrlEn);
    });

    document.querySelectorAll("[data-primary-nav]").forEach((nav) => {
      nav.setAttribute("aria-label", language === "ar" ? "التنقل الرئيسي" : "Primary navigation");
    });
    document.querySelector("[data-footer-nav]")?.setAttribute("aria-label", language === "ar" ? "تنقل التذييل" : "Footer navigation");

    const menuLabel = mobileMenuOpen
      ? (language === "ar" ? ui.menuCloseAr : ui.menuCloseEn)
      : (language === "ar" ? ui.menuOpenAr : ui.menuOpenEn);
    menuButton?.setAttribute("aria-label", menuLabel);

    if (announce) {
      const status = document.getElementById("language-status");
      if (status) status.textContent = language === "ar" ? "تم التبديل إلى العربية" : "Switched to English";
    }

    try {
      window.localStorage.setItem("whano-language", language);
    } catch {
      // Language still changes for this visit when storage is unavailable.
    }
  }

  languageToggle?.addEventListener("click", () => {
    const current = document.documentElement.dataset.language === "ar" ? "ar" : "en";
    setLanguage(current === "en" ? "ar" : "en");
  });

  menuButton?.addEventListener("click", () => {
    mobileMenuOpen = mobileNav?.classList.toggle("is-open") ?? false;
    menuButton.setAttribute("aria-expanded", String(mobileMenuOpen));
    setLanguage(document.documentElement.dataset.language === "ar" ? "ar" : "en", false);
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav.classList.remove("is-open");
      mobileMenuOpen = false;
      menuButton?.setAttribute("aria-expanded", "false");
      setLanguage(document.documentElement.dataset.language === "ar" ? "ar" : "en", false);
    });
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && mobileMenuOpen) {
      mobileNav?.classList.remove("is-open");
      mobileMenuOpen = false;
      menuButton?.setAttribute("aria-expanded", "false");
      setLanguage(document.documentElement.dataset.language === "ar" ? "ar" : "en", false);
      menuButton?.focus();
    }
  });

  window.addEventListener("scroll", () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 12);
  }, { passive: true });

  setLanguage(document.documentElement.dataset.language === "ar" ? "ar" : "en", false);
</script>
