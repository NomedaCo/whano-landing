---
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-[1120px] px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-heading text-lg font-bold text-text tracking-tight">whano</a>

    <div class="hidden md:flex items-center gap-7">
      <a href="#features" class="text-sm text-muted hover:text-text transition-colors">Features</a>
      <a href="#pricing" class="text-sm text-muted hover:text-text transition-colors">Pricing</a>
      <a href="#faq" class="text-sm text-muted hover:text-text transition-colors">FAQ</a>
      <a href="https://apps.shopify.com/" target="_blank" rel="noopener noreferrer"
         class="h-9 px-5 inline-flex items-center gap-1.5 bg-accent text-bg text-sm font-semibold rounded-lg hover:bg-accent-hover transition-colors">
        Install on Shopify
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <button id="menu-btn" class="md:hidden text-muted hover:text-text transition-colors" aria-label="Menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-border px-6 pb-4">
    <div class="flex flex-col gap-3 pt-3">
      <a href="#features" class="text-sm text-muted hover:text-text transition-colors">Features</a>
      <a href="#pricing" class="text-sm text-muted hover:text-text transition-colors">Pricing</a>
      <a href="#faq" class="text-sm text-muted hover:text-text transition-colors">FAQ</a>
      <a href="https://apps.shopify.com/" target="_blank" rel="noopener noreferrer"
         class="h-9 px-5 inline-flex items-center justify-center gap-1.5 bg-accent text-bg text-sm font-semibold rounded-lg hover:bg-accent-hover transition-colors mt-1">
        Install on Shopify
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav");
  const btn = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  window.addEventListener("scroll", () => {
    nav?.classList.toggle("nav-scrolled", window.scrollY > 20);
  });
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
