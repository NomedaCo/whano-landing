---
const metrics = [
  { value: "< 3s", label: "Response time" },
  { value: "5 min", label: "Setup time" },
  { value: "2", label: "Languages supported" },
  { value: "100%", label: "Order lifecycle covered" },
];

const testimonials = [
  {
    quote: "Whano confirmed 200 orders in the first week. I didn't touch my phone once.",
    author: "Ahmed M.",
    role: "Shopify merchant, Cairo",
  },
  {
    quote: "My customers love getting updates in Arabic. No more 'where is my order?' calls.",
    author: "Sara K.",
    role: "Fashion store owner",
  },
];
---

<section class="py-20 md:py-28 border-t border-border">
  <div class="mx-auto max-w-6xl px-6">
    <!-- Metrics -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-20 reveal">
      {metrics.map((metric) => (
        <div class="text-center">
          <p class="font-heading text-3xl md:text-4xl font-bold text-accent mb-1">{metric.value}</p>
          <p class="text-sm text-text-muted">{metric.label}</p>
        </div>
      ))}
    </div>

    <!-- Testimonials -->
    <div class="text-center mb-12 reveal">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-4 tracking-tight">
        What merchants say
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {testimonials.map((t) => (
        <div class="reveal p-8 rounded-xl border border-border bg-bg-surface">
          <p class="text-text-secondary leading-relaxed mb-6">"{t.quote}"</p>
          <div>
            <p class="font-heading font-semibold text-text-primary text-sm">{t.author}</p>
            <p class="text-xs text-text-muted">{t.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
