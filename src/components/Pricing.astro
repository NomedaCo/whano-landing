---
import { plans, site } from "../data/content";
---

<section id="pricing" class="section">
  <div class="site-frame">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">
          <span data-copy="en">{site.pricing.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.pricing.eyebrow.ar}</span>
        </p>
      </div>
      <div>
        <h2 class="section-title">
          <span data-copy="en">{site.pricing.title.en}</span>
          <span data-copy="ar" lang="ar">{site.pricing.title.ar}</span>
        </h2>
        <p class="section-copy">
          <span data-copy="en">{site.pricing.body.en}</span>
          <span data-copy="ar" lang="ar">{site.pricing.body.ar}</span>
        </p>
      </div>
    </div>

    <div class="price-table reveal" role="region" aria-label="Pricing plans" tabindex="0">
      <div class="price-head">
        <span class="price-head-label">
          <span data-copy="en">Choose a pack</span>
          <span data-copy="ar" lang="ar">اختار الباقة</span>
        </span>
        {plans.map((plan) => (
          <span class:list={["price-head-label", plan.popular && "price-head-label--featured"]}>
            <span data-copy="en">{plan.name.en}</span>
            <span data-copy="ar" lang="ar">{plan.name.ar}</span>
          </span>
        ))}
      </div>

      <div class="price-grid">
        <div class="price-grid__label">
          <span data-copy="en">What’s included</span>
          <span data-copy="ar" lang="ar">الباقة فيها إيه</span>
        </div>
        {plans.map((plan) => (
          <div class:list={["price-plan", plan.popular && "price-plan--featured"]}>
            <h3 class="price-name">
              <span data-copy="en">{plan.name.en}</span>
              <span data-copy="ar" lang="ar">{plan.name.ar}</span>
            </h3>
            <p class="price-description">
              <span data-copy="en">{plan.description.en}</span>
              <span data-copy="ar" lang="ar">{plan.description.ar}</span>
            </p>
            <p class="price-amount">
              <span data-copy="en">{plan.price.en}</span>
              <span data-copy="ar" lang="ar">{plan.price.ar}</span>
            </p>
            <p class="price-points">
              <span data-copy="en">{plan.points.en}</span>
              <span data-copy="ar" lang="ar">{plan.points.ar}</span>
            </p>
            <ul class="price-list">
              {plan.features.map((feature) => (
                <li>
                  <span data-copy="en">{feature.en}</span>
                  <span data-copy="ar" lang="ar">{feature.ar}</span>
                </li>
              ))}
            </ul>
            <a href={site.accessUrl.en} data-access-link class="price-link">
              <span data-copy="en">Request access</span>
              <span data-copy="ar" lang="ar">اطلب الوصول</span>
            </a>
          </div>
        ))}
      </div>
    </div>

    <p class="price-note reveal">
      <span data-copy="en">{site.pricing.note.en}</span>
      <span data-copy="ar" lang="ar">{site.pricing.note.ar}</span>
    </p>
  </div>
</section>
