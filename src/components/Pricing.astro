---
import { plans, pricingFeatures, site } from "../data/content";

const standardPlans = plans.filter((p) => !("isEnterprise" in p && p.isEnterprise));
---

<section id="pricing" class="section">
  <div class="site-frame">
    <div class="section-heading reveal">
      <p class="eyebrow">
        <span data-copy="en">{site.pricing.eyebrow.en}</span>
        <span data-copy="ar" lang="ar">{site.pricing.eyebrow.ar}</span>
      </p>
      <h2 class="section-title">
        <span data-copy="en">{site.pricing.title.en}</span>
        <span data-copy="ar" lang="ar">{site.pricing.title.ar}</span>
      </h2>
      <p class="section-copy">
        <span data-copy="en">{site.pricing.body.en}</span>
        <span data-copy="ar" lang="ar">{site.pricing.body.ar}</span>
      </p>
    </div>

    <!-- 4 Standard Point Packs -->
    <div class="pricing-grid reveal">
      {standardPlans.map((plan) => (
        <div class:list={["pricing-card", plan.popular && "pricing-card--featured"]}>
          {plan.popular && (
            <span class="pricing-badge">
              <span data-copy="en">Best value per point</span>
              <span data-copy="ar" lang="ar">أفضل قيمة لكل نقطة</span>
            </span>
          )}

          <div class="pricing-card__header">
            <h3 class="pricing-card__name">
              <span data-copy="en">{plan.name.en}</span>
              <span data-copy="ar" lang="ar">{plan.name.ar}</span>
            </h3>
            <p class="pricing-card__description">
              <span data-copy="en">{plan.description.en}</span>
              <span data-copy="ar" lang="ar">{plan.description.ar}</span>
            </p>
          </div>

          {plan.priceEgp !== null && (
            <div class="pricing-card__price">
              <span class="pricing-card__current">
                <bdi dir="ltr">{plan.priceEgp.toLocaleString("en-US")}</bdi>
                <span data-copy="en">EGP</span>
                <span data-copy="ar" lang="ar">جنيه</span>
              </span>
            </div>
          )}

          <p class="pricing-card__points">
            <span data-copy="en">{plan.points.en}</span>
            <span data-copy="ar" lang="ar">{plan.points.ar}</span>
          </p>

          <a
            href={site.accessUrl.en}
            data-access-link
            class:list={["pricing-card__cta", plan.popular && "pricing-card__cta--featured"]}
          >
            
            <span data-copy="en">Start now</span>
            <span data-copy="ar" lang="ar">ابدأ الآن</span>
          </a>
        </div>
      ))}
    </div>

    <!-- Custom / High Volume Banner -->
    <div class="pricing-custom-card reveal">
      <div class="pricing-custom-card__info">
        <h3 class="pricing-custom-card__title">
          <span data-copy="en">Need a custom volume or higher points bundle?</span>
          <span data-copy="ar" lang="ar">تحتاج باقة مخصصة أو استهلاك نقاط أكبر؟</span>
        </h3>
        <p class="pricing-custom-card__desc">
          <span data-copy="en">We offer tailored bundles and dedicated support for high-volume stores.</span>
          <span data-copy="ar" lang="ar">نوفر باقات مخصصة ودعمًا مخصصًا للمتاجر ذات حجم الطلبات الكبير.</span>
        </p>
      </div>
      <a href="/contact/" class="pricing-custom-card__cta">
        <span data-copy="en">Contact us</span>
        <span data-copy="ar" lang="ar">تواصل معنا</span>
      </a>
    </div>

    <div class="pricing-features reveal">
      <ul class="pricing-features__list">
        {pricingFeatures.map((feature) => (
          <li>
            <span data-copy="en">{feature.en}</span>
            <span data-copy="ar" lang="ar">{feature.ar}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="price-note reveal">
      <span data-copy="en">{site.pricing.note.en}</span>
      <span data-copy="ar" lang="ar">{site.pricing.note.ar}</span>
    </p>
  </div>
</section>
