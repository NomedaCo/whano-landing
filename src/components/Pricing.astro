---
import { plans, planPricesUsd, pricingFeatures, site } from "../data/content";

const FALLBACK_RATE = 50;

async function fetchEgpRate(): Promise<number> {
  try {
    const res = await fetch("https://api.frankfurter.app/latest?from=USD&to=EGP", {
      signal: AbortSignal.timeout(5000),
    });
    if (!res.ok) return FALLBACK_RATE;
    const data = await res.json();
    return data?.rates?.EGP ?? FALLBACK_RATE;
  } catch {
    return FALLBACK_RATE;
  }
}

const rate = await fetchEgpRate();

const egpValues = planPricesUsd.map((usd) => {
  if (usd === null) return null;
  return Math.round(usd * rate).toLocaleString("en");
});
---

<section id="pricing" class="section">
  <div class="site-frame">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">
          <span data-copy="en">{site.pricing.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.pricing.eyebrow.ar}</span>
        </p>
      </div>
      <div>
        <h2 class="section-title">
          <span data-copy="en">{site.pricing.title.en}</span>
          <span data-copy="ar" lang="ar">{site.pricing.title.ar}</span>
        </h2>
        <p class="section-copy">
          <span data-copy="en">{site.pricing.body.en}</span>
          <span data-copy="ar" lang="ar">{site.pricing.body.ar}</span>
        </p>
      </div>
    </div>

    <div class="pricing-grid reveal">
      {plans.map((plan, i) => (
        <div
          class:list={["pricing-card", plan.popular && "pricing-card--featured", (plan as any).isEnterprise && "pricing-card--enterprise"]}
        >
          {plan.popular && (
            <span class="pricing-badge">
              <span data-copy="en">Most popular</span>
              <span data-copy="ar" lang="ar">الأكثر شيوعًا</span>
            </span>
          )}
          <div class="pricing-card__header">
            <h3 class="pricing-card__name">
              <span data-copy="en">{plan.name.en}</span>
              <span data-copy="ar" lang="ar">{plan.name.ar}</span>
            </h3>
            <p class="pricing-card__description">
              <span data-copy="en">{plan.description.en}</span>
              <span data-copy="ar" lang="ar">{plan.description.ar}</span>
            </p>
          </div>

          <div class="pricing-card__price">
            {plan.originalPrice && (
              <span class="pricing-card__original">
                <span data-copy="en">{plan.originalPrice.en}</span>
                <span data-copy="ar" lang="ar">{plan.originalPrice.ar}</span>
              </span>
            )}
            <span class="pricing-card__current">
              <span data-copy="en">{plan.price.en}</span>
              <span data-copy="ar" lang="ar">{plan.price.ar}</span>
            </span>
          </div>

          {egpValues[i] && (
            <span class="pricing-card__egp">
              <span data-copy="en">{`\u2248 ${egpValues[i]} EGP`}</span>
              <span data-copy="ar" lang="ar">{`\u2248 ${egpValues[i]} \u062c\u0646\u064a\u0647`}</span>
            </span>
          )}

          <p class="pricing-card__points">
            <span data-copy="en">{plan.points.en}</span>
            <span data-copy="ar" lang="ar">{plan.points.ar}</span>
          </p>

          {(plan as any).isEnterprise ? (
            <a href={site.accessUrl.en} data-access-link class="pricing-card__cta pricing-card__cta--enterprise">
              <span data-copy="en">Contact us</span>
              <span data-copy="ar" lang="ar">كلمنا</span>
            </a>
          ) : (
            <a href={site.accessUrl.en} data-access-link class:list={["pricing-card__cta", plan.popular && "pricing-card__cta--featured"]}>
              <span data-copy="en">Install on Shopify</span>
              <span data-copy="ar" lang="ar">ثبّت على Shopify</span>
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="pricing-features reveal">
      <ul class="pricing-features__list">
        {pricingFeatures.map((feature) => (
          <li>
            <span data-copy="en">{feature.en}</span>
            <span data-copy="ar" lang="ar">{feature.ar}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="price-note reveal">
      <span data-copy="en">{site.pricing.note.en}</span>
      <span data-copy="ar" lang="ar">{site.pricing.note.ar}</span>
    </p>
  </div>
</section>
