---
import { site } from "../data/content";

const { operations } = site;
---

<section id="flow" class="section operations-section">
  <span id="features" class="section-anchor" aria-hidden="true"></span>
  <div class="site-frame">
    <div class="section-heading operations-heading reveal">
      <div>
        <p class="eyebrow">
          <span data-copy="en">{operations.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{operations.eyebrow.ar}</span>
        </p>
      </div>
      <div>
        <h2 class="section-title">
          <span data-copy="en">{operations.title.en}</span>
          <span data-copy="ar" lang="ar">{operations.title.ar}</span>
        </h2>
        <p class="section-copy">
          <span data-copy="en">{operations.body.en}</span>
          <span data-copy="ar" lang="ar">{operations.body.ar}</span>
        </p>
      </div>
    </div>

    <div class="operations-compare reveal">
      <article class="operations-panel operations-panel--problem">
        <div class="operations-panel__topline">
          <span class="operations-panel__marker" aria-hidden="true">01</span>
          <span class="operations-panel__label">
            <span data-copy="en">{operations.problem.label.en}</span>
            <span data-copy="ar" lang="ar">{operations.problem.label.ar}</span>
          </span>
        </div>
        <h3 class="operations-panel__title">
          <span data-copy="en">{operations.problem.title.en}</span>
          <span data-copy="ar" lang="ar">{operations.problem.title.ar}</span>
        </h3>
        <ul class="operations-list">
          {operations.problem.items.map((item) => (
            <li>
              <span class="operations-list__icon" aria-hidden="true">-</span>
              <span>
                <strong>
                  <span data-copy="en">{item.title.en}</span>
                  <span data-copy="ar" lang="ar">{item.title.ar}</span>
                </strong>
                <span class="operations-list__body">
                  <span data-copy="en">{item.body.en}</span>
                  <span data-copy="ar" lang="ar">{item.body.ar}</span>
                </span>
              </span>
            </li>
          ))}
        </ul>
      </article>

      <div class="operations-compare__connector" aria-hidden="true">
        <span>→</span>
      </div>

      <article class="operations-panel operations-panel--solution">
        <div class="operations-panel__topline">
          <span class="operations-panel__marker" aria-hidden="true">02</span>
          <span class="operations-panel__label">
            <span data-copy="en">{operations.solution.label.en}</span>
            <span data-copy="ar" lang="ar">{operations.solution.label.ar}</span>
          </span>
        </div>
        <h3 class="operations-panel__title">
          <span data-copy="en">{operations.solution.title.en}</span>
          <span data-copy="ar" lang="ar">{operations.solution.title.ar}</span>
        </h3>
        <ul class="operations-list">
          {operations.solution.items.map((item) => (
            <li>
              <span class="operations-list__icon" aria-hidden="true">+</span>
              <span>
                <strong>
                  <span data-copy="en">{item.title.en}</span>
                  <span data-copy="ar" lang="ar">{item.title.ar}</span>
                </strong>
                <span class="operations-list__body">
                  <span data-copy="en">{item.body.en}</span>
                  <span data-copy="ar" lang="ar">{item.body.ar}</span>
                </span>
              </span>
            </li>
          ))}
        </ul>
      </article>
    </div>

    <div class="operations-flow">
      <div class="operations-flow__heading reveal">
        <p class="eyebrow">
          <span data-copy="en">{operations.flow.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{operations.flow.eyebrow.ar}</span>
        </p>
        <h3>
          <span data-copy="en">{operations.flow.title.en}</span>
          <span data-copy="ar" lang="ar">{operations.flow.title.ar}</span>
        </h3>
      </div>

      <ol class="operations-timeline">
        {operations.flow.steps.map((step) => (
          <li class="operations-step reveal">
            <div class="operations-step__number">{step.number}</div>
            <div class="operations-step__content">
              <p class="operations-step__trigger">
                <span data-copy="en">{step.trigger.en}</span>
                <span data-copy="ar" lang="ar">{step.trigger.ar}</span>
              </p>
              <h4>
                <span data-copy="en">{step.title.en}</span>
                <span data-copy="ar" lang="ar">{step.title.ar}</span>
              </h4>
              <p class="operations-step__body">
                <span data-copy="en">{step.body.en}</span>
                <span data-copy="ar" lang="ar">{step.body.ar}</span>
              </p>
              <p class="operations-step__result">
                <span class="operations-step__result-label">
                  <span data-copy="en">Result</span>
                  <span data-copy="ar" lang="ar">النتيجة</span>
                </span>
                <span data-copy="en">{step.result.en}</span>
                <span data-copy="ar" lang="ar">{step.result.ar}</span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="operations-controls reveal">
      <p class="operations-controls__label">
        <span data-copy="en">{operations.controls.label.en}</span>
        <span data-copy="ar" lang="ar">{operations.controls.label.ar}</span>
      </p>
      <ul>
        {operations.controls.items.map((item) => (
          <li>
            <span aria-hidden="true">+</span>
            <span data-copy="en">{item.en}</span>
            <span data-copy="ar" lang="ar">{item.ar}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
