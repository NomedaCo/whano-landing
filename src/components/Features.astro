---
import { features, orderFlow, site } from "../data/content";
---

<section id="features" class="section">
  <div class="site-frame">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">
          <span data-copy="en">{site.problem.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.problem.eyebrow.ar}</span>
        </p>
      </div>
      <div>
        <h2 class="section-title">
          <span data-copy="en">{site.problem.title.en}</span>
          <span data-copy="ar" lang="ar">{site.problem.title.ar}</span>
        </h2>
      </div>
    </div>

    <div class="problem-compare reveal">
      <div class="problem-column">
        <span class="problem-column__label">
          <span data-copy="en">{site.problem.without.en}</span>
          <span data-copy="ar" lang="ar">{site.problem.without.ar}</span>
        </span>
        <ul class="problem-list">
          <li>
            <span data-copy="en">New orders sit unread until you check WhatsApp</span>
            <span data-copy="ar" lang="ar">الطلبات الجديدة مستنية لحد ما تفتح واتساب</span>
          </li>
          <li>
            <span data-copy="en">Customers ask the same questions you already answered</span>
            <span data-copy="ar" lang="ar">العملاء بيسألوا نفس الأسئلة اللي جاوبت عليها قبل كده</span>
          </li>
          <li>
            <span data-copy="en">You forget to ask for a review after delivery</span>
            <span data-copy="ar" lang="ar">تنسى تطلب تقييم بعد ما يوصّل</span>
          </li>
        </ul>
      </div>
      <div class="problem-column problem-column--good">
        <span class="problem-column__label">
          <span data-copy="en">{site.problem.with.en}</span>
          <span data-copy="ar" lang="ar">{site.problem.with.ar}</span>
        </span>
        <ul class="problem-list">
          <li>
            <span data-copy="en">Every new order gets a WhatsApp confirmation instantly</span>
            <span data-copy="ar" lang="ar">كل طلب جديد بياخد تأكيد واتساب فورًا</span>
          </li>
          <li>
            <span data-copy="en">The customer sees order details without asking you</span>
            <span data-copy="ar" lang="ar">العميل بيشوف تفاصيل الطلب من غير ما يسألك</span>
          </li>
          <li>
            <span data-copy="en">Shipping updates and review requests go out automatically</span>
            <span data-copy="ar" lang="ar">تحديثات الشحن وطلب التقييم بتتبعت تلقائي</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="flow-grid reveal">
      {orderFlow.map((step) => (
        <div class="flow-item">
          <span class="flow-number">{step.number}</span>
          <h3 class="flow-title">
            <span data-copy="en">{step.title.en}</span>
            <span data-copy="ar" lang="ar">{step.title.ar}</span>
          </h3>
        </div>
      ))}
    </div>

    <div class="feature-list">
      {features.slice(0, 2).map((feature) => (
        <article class="feature-row reveal">
          <span class="feature-number">{feature.number}</span>
          <div>
            <h3 class="feature-title">
              <span data-copy="en">{feature.title.en}</span>
              <span data-copy="ar" lang="ar">{feature.title.ar}</span>
            </h3>
            <p class="feature-body">
              <span data-copy="en">{feature.body.en}</span>
              <span data-copy="ar" lang="ar">{feature.body.ar}</span>
            </p>
          </div>
        </article>
      ))}
    </div>

    <ul class="control-bullets reveal">
      {site.control.points.map((point) => (
        <li>
          <span data-copy="en">{point.title.en}</span>
          <span data-copy="ar" lang="ar">{point.title.ar}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
