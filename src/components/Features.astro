---
const features = [
  {
    title: "Order confirmations",
    desc: "Customer places an order. Whano sends a WhatsApp confirmation in seconds. They reply with a checkmark or text — done.",
    icon: "check",
  },
  {
    title: "Product recommendations",
    desc: "After confirmation, Whano suggests products based on real co-purchase data. Customer says \"add it\" — the Shopify order updates automatically.",
    icon: "sparkle",
  },
  {
    title: "Shipping notifications",
    desc: "You fulfill an order. Whano sends the tracking info and delivery window to the customer. No more \"where's my order?\" messages.",
    icon: "truck",
  },
  {
    title: "Review collection",
    desc: "24-48 hours after delivery, Whano asks for a review. One message, one reply. Reviews stored in your dashboard.",
    icon: "star",
  },
  {
    title: "Bilingual support",
    desc: "Speaks Egyptian Arabic and English. Detects customer language automatically. Responds naturally in the right dialect.",
    icon: "language",
  },
  {
    title: "Order modifications",
    desc: "Customer wants to add an item or change quantity? They text back. Whano handles it and updates the real Shopify order.",
    icon: "edit",
  },
];
---

<section id="features" class="py-16 md:py-24 border-t border-border">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="reveal mb-12">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-text tracking-tight mb-3">What Whano does</h2>
      <p class="text-body max-w-lg">Six things. Each one saves you time and makes your customers happier.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="reveal p-6 rounded-lg border border-border bg-surface hover:border-border/80 transition-colors">
          <div class="w-9 h-9 rounded-md bg-accent/10 flex items-center justify-center mb-4">
            {f.icon === "check" && (
              <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            )}
            {f.icon === "sparkle" && (
              <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
            )}
            {f.icon === "truck" && (
              <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
            )}
            {f.icon === "star" && (
              <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
            )}
            {f.icon === "language" && (
              <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"/></svg>
            )}
            {f.icon === "edit" && (
              <svg class="w-4.5 h-4.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            )}
          </div>
          <h3 class="font-heading text-sm font-bold text-text mb-1.5">{f.title}</h3>
          <p class="text-sm text-muted leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
