---
import { site } from "../data/content";
---

<!--
  The phone conversion bar.

  The header's install/login button is hidden below 900px, so on a phone the
  only way to act was to open the menu. This appears after the hero and stays
  reachable without covering the footer (body padding follows the class).
-->
<div class="mobile-cta" id="mobile-cta">
  <a href={site.consoleUrl.en} data-console-link class="mobile-cta__login">
    <span data-copy="en">{site.nav.login.en}</span>
    <span data-copy="ar" lang="ar">{site.nav.login.ar}</span>
  </a>
  <a href={site.accessUrl.en} data-access-link class="mobile-cta__install">
    <span data-copy="en">{site.nav.cta.en}</span>
    <span data-copy="ar" lang="ar">{site.nav.cta.ar}</span>
  </a>
</div>

<script>
  const bar = document.getElementById("mobile-cta");
  if (bar) {
    const update = () => {
      const visible = window.scrollY > 560;
      bar.classList.toggle("is-visible", visible);
      document.body.classList.toggle("has-mobile-cta", visible);
    };
    window.addEventListener("scroll", update, { passive: true });
    update();
  }
</script>
