---
const partners = [
  { name: "Nomeda", src: "/logos/nomeda.svg", width: 196, height: 48 },
  { name: "Madar", src: "/logos/madar.svg", width: 220, height: 48 },
  { name: "Shopify", src: "/logos/shopify.svg", width: 24, height: 24, icon: true, label: "Shopify" },
  { name: "Meta / WhatsApp", src: "/logos/whatsapp.svg", width: 24, height: 24, icon: true, label: "Meta / WhatsApp" },
  { name: "Bosta", src: "/logos/bosta.png", width: 112, height: 32 },
  { name: "ShipBlu", src: "/logos/shipblu.png", width: 1967, height: 446 },
  { name: "J&T Express", src: "/logos/jnt.svg", width: 500, height: 105 },
];
---

<section class="play-partners" id="partners" aria-labelledby="partners-title">
  <div class="site-frame">
    <div class="play-partners__panel play-reveal" data-play-reveal>
      <span class="play-partners__shape play-partners__shape--star" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 1l2.4 7.6L22 11l-7.6 2.4L12 21l-2.4-7.6L2 11l7.6-2.4z" />
        </svg>
      </span>
      <span class="play-partners__shape play-partners__shape--ring" aria-hidden="true"></span>
      <span class="play-partners__shape play-partners__shape--dot" aria-hidden="true"></span>
      <span class="play-partners__shape play-partners__shape--blob" aria-hidden="true"></span>

      <div class="play-partners__head">
        <p class="eyebrow">
          <span data-copy="en">Partners &amp; ecosystem</span>
          <span data-copy="ar" lang="ar">الشركاء والمنظومة</span>
        </p>
        <h2 class="play-partners__title" id="partners-title">
          <span data-copy="en">Better together, by design.</span>
          <span data-copy="ar" lang="ar">أفضل معًا، بالتصميم.</span>
        </h2>
        <p class="play-partners__copy">
          <span data-copy="en">Whano is built by Nomeda, its app guide runs on Madar, and the product connects to Shopify, Meta's WhatsApp Cloud API, and the carrier you choose.</span>
          <span data-copy="ar" lang="ar">Whano من إنتاج Nomeda، ودليل تطبيقه يعمل على Madar، ويتصل المنتج بـ Shopify وواجهة WhatsApp Cloud API من Meta وشركة الشحن التي تختارها.</span>
        </p>
      </div>

      <div class="play-partners__marquee">
        <div class="play-partners__track" dir="ltr">
          {[0, 1].map((copyIndex) => (
            <ul class="play-partners__set" aria-hidden={copyIndex === 1 ? "true" : undefined}>
              {partners.map((partner) => (
                <li class:list={["play-partners__item", partner.icon && "play-partners__item--icon"]}>
                  <img
                    src={partner.src}
                    alt={copyIndex === 1 ? "" : partner.name}
                    width={partner.width}
                    height={partner.height}
                    loading="lazy"
                    decoding="async"
                  />
                  {partner.label && <span class="play-partners__label">{partner.label}</span>}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>

      <p class="play-partners__note">
        <span data-copy="en">The platforms, products, and carriers behind the work.</span>
        <span data-copy="ar" lang="ar">المنصات والمنتجات وشركات الشحن خلف العمل.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .play-partners {
    position: relative;
    padding-block: 76px 12px;
    background: #ffffff;
    overflow: clip;
  }

  .play-partners__panel {
    position: relative;
    overflow: hidden;
    padding: 38px 0 30px;
    border: 1.5px solid var(--pl-line);
    border-radius: 40px;
    background:
      radial-gradient(540px 300px at 88% -10%, rgba(255, 213, 74, 0.34), transparent 70%),
      radial-gradient(560px 330px at 0% 110%, rgba(224, 216, 255, 0.72), transparent 72%),
      linear-gradient(135deg, #fffdf5 0%, #fbf9ff 55%, #f2fbf6 100%);
    box-shadow: 0 26px 60px rgba(22, 18, 43, 0.07);
  }

  .play-partners__shape {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }

  .play-partners__shape--star {
    top: 34px;
    inset-inline-end: 9%;
    width: 28px;
    height: 28px;
    color: var(--pl-yellow-strong);
    animation: partners-float 5s ease-in-out infinite;
  }

  .play-partners__shape--star svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .play-partners__shape--ring {
    top: 64px;
    inset-inline-end: 18%;
    width: 16px;
    height: 16px;
    border: 3px solid var(--pl-purple);
    border-radius: 50%;
    opacity: 0.7;
    animation: partners-float 6s ease-in-out infinite reverse;
  }

  .play-partners__shape--dot {
    bottom: 88px;
    inset-inline-start: 8%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pl-orange);
    animation: partners-float 4.5s ease-in-out infinite;
  }

  .play-partners__shape--blob {
    top: -70px;
    inset-inline-start: -32px;
    width: 170px;
    height: 170px;
    border-radius: 50%;
    background: rgba(207, 245, 221, 0.45);
    filter: blur(5px);
  }

  .play-partners__head {
    position: relative;
    z-index: 1;
    max-width: 780px;
    padding: 0 42px 30px;
  }

  .play-partners__title {
    margin: 14px 0 12px;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .play-partners__copy {
    max-width: 680px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.85;
  }

  .play-partners__marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: 8px 16px;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }

  .play-partners__track {
    display: flex;
    width: max-content;
    animation: partners-scroll 42s linear infinite;
  }

  .play-partners__marquee:hover .play-partners__track {
    animation-play-state: paused;
  }

  .play-partners__set {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0 6px;
    list-style: none;
  }

  .play-partners__item {
    display: flex;
    height: 76px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 26px;
    border: 1.5px solid rgba(22, 18, 43, 0.08);
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 10px 24px rgba(22, 18, 43, 0.06);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .play-partners__item:hover {
    transform: translateY(-3px) rotate(-1deg);
    box-shadow: 0 16px 30px rgba(22, 18, 43, 0.1);
  }

  .play-partners__item img {
    display: block;
    width: auto;
    max-width: 132px;
    max-height: 32px;
    height: auto;
    object-fit: contain;
  }

  .play-partners__item--icon img {
    max-width: 30px;
    max-height: 30px;
  }

  .play-partners__label {
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  .play-partners__note {
    position: relative;
    z-index: 1;
    margin: 2px 42px 0;
    color: var(--ink-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  :global(html[data-language="ar"]) .play-partners__title {
    letter-spacing: -0.02em;
    line-height: 1.42;
  }

  @keyframes partners-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes partners-float {
    0%,
    100% {
      transform: translateY(0) rotate(0);
    }
    50% {
      transform: translateY(-10px) rotate(8deg);
    }
  }

  @media (max-width: 900px) {
    .play-partners {
      padding-block: 56px 8px;
    }

    .play-partners__panel {
      padding-top: 30px;
      border-radius: 30px;
    }

    .play-partners__head {
      padding: 0 24px 22px;
    }

    .play-partners__title {
      font-size: clamp(1.8rem, 7vw, 2.5rem);
    }

    .play-partners__copy {
      font-size: 14px;
    }

    .play-partners__item {
      height: 62px;
      padding: 0 18px;
      border-radius: 18px;
    }

    .play-partners__item img {
      max-width: 104px;
      max-height: 26px;
    }

    .play-partners__item--icon img {
      max-width: 26px;
      max-height: 26px;
    }

    .play-partners__label {
      font-size: 12px;
    }

    .play-partners__note {
      margin-inline: 24px;
    }

    .play-partners__shape {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .play-partners__track {
      width: auto;
      flex-wrap: wrap;
      animation: none;
    }

    .play-partners__set {
      flex-wrap: wrap;
      justify-content: center;
    }

    .play-partners__set[aria-hidden="true"] {
      display: none;
    }

    .play-partners__marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .play-partners__item,
    .play-partners__shape {
      animation: none;
    }
  }
</style>
