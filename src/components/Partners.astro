---
const partners = [
  { name: "Nomeda", src: "/logos/nomeda.svg", width: 196, height: 48 },
  { name: "Madar", src: "/logos/madar.svg", width: 220, height: 48 },
  { name: "Shopify", src: "/logos/shopify.svg", width: 24, height: 24, icon: true, label: "Shopify" },
  { name: "Meta / WhatsApp", src: "/logos/whatsapp.svg", width: 24, height: 24, icon: true, label: "Meta / WhatsApp" },
  { name: "Bosta", src: "/logos/bosta.png", width: 112, height: 32 },
  { name: "ShipBlu", src: "/logos/shipblu.png", width: 1967, height: 446 },
  { name: "J&T Express", src: "/logos/jnt.svg", width: 500, height: 105 },
];
---

<section class="partners-band" id="partners" aria-labelledby="partners-title">
  <div class="site-frame">
    <div class="partners-band__head">
      <div class="partners-band__copy">
        <p class="eyebrow">
          <span data-copy="en">Partners</span>
          <span data-copy="ar" lang="ar">الشركاء</span>
        </p>
        <h2 class="partners-band__title" id="partners-title">
          <span data-copy="en">Whano is a Nomeda product. Its app guide runs on Madar.</span>
          <span data-copy="ar" lang="ar">Whano منتج من Nomeda، ودليل التطبيق يعمل على Madar.</span>
        </h2>
        <p>
          <span data-copy="en">Connected to Shopify, Meta's WhatsApp Cloud API, and the carrier you choose.</span>
          <span data-copy="ar" lang="ar">متصل بـ Shopify، وواجهة WhatsApp Cloud API من Meta، وشركة الشحن التي تختارها.</span>
        </p>
      </div>
      <a class="section-link" href="/integrations/">
        <span data-copy="en">All integrations</span>
        <span data-copy="ar" lang="ar">كل التكاملات</span>
        <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
          <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <ul class="partners-band__logos">
      {partners.map((partner) => (
        <li class:list={["partners-band__item", partner.icon && "partners-band__item--icon"]}>
          <img
            src={partner.src}
            alt={partner.name}
            width={partner.width}
            height={partner.height}
            loading="lazy"
            decoding="async"
          />
          {partner.label && <span class="partners-band__label">{partner.label}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners-band {
    padding-block: 64px 56px;
    border-top: 1.5px solid var(--pl-line);
    background: #ffffff;
  }

  .partners-band__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }

  .partners-band__copy {
    max-width: 660px;
  }

  .partners-band__title {
    margin: 12px 0 6px;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(1.15rem, 2.1vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.5;
    text-wrap: balance;
  }

  .partners-band__copy > p:last-child {
    margin: 0;
    color: var(--ink-soft);
    font-size: 14.5px;
    line-height: 1.8;
  }

  .partners-band__head .section-link {
    flex: 0 0 auto;
    padding-bottom: 2px;
  }

  .partners-band__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 32px;
    margin: 34px 0 0;
    padding: 24px 0 0;
    border-top: 1.5px solid var(--pl-line);
    list-style: none;
  }

  .partners-band__item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .partners-band__item img {
    display: block;
    width: auto;
    max-width: 110px;
    max-height: 24px;
    height: auto;
    object-fit: contain;
  }

  .partners-band__item--icon img {
    max-width: 24px;
    max-height: 24px;
  }

  .partners-band__label {
    color: var(--ink-soft);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  :global(html[data-language="ar"]) .partners-band__title {
    letter-spacing: -0.02em;
    line-height: 1.42;
  }

  @media (max-width: 900px) {
    .partners-band {
      padding-block: 52px 44px;
    }

    .partners-band__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 18px;
    }

    .partners-band__logos {
      justify-content: flex-start;
      margin-top: 28px;
    }
  }

  @media (max-width: 520px) {
    .partners-band__logos {
      gap: 16px 22px;
    }

    .partners-band__item img {
      max-width: 92px;
      max-height: 22px;
    }

    .partners-band__item--icon img {
      max-width: 22px;
      max-height: 22px;
    }
  }
</style>
