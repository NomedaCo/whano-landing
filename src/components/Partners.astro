---
const partners = [
  {
    name: "Nomeda",
    src: "/logos/nomeda.svg",
    width: 196,
    height: 48,
    role: { en: "Company", ar: "الشركة" },
    tone: "#e0d8ff",
  },
  {
    name: "Madar",
    src: "/logos/madar.svg",
    width: 220,
    height: 48,
    role: { en: "AI app guide", ar: "دليل التطبيق الذكي" },
    tone: "#ffd9cc",
  },
  {
    name: "Shopify",
    src: "/logos/shopify.svg",
    width: 24,
    height: 24,
    role: { en: "Store platform", ar: "منصة المتجر" },
    tone: "#cff5dd",
    icon: true,
  },
  {
    name: "Meta / WhatsApp",
    src: "/logos/whatsapp.svg",
    width: 24,
    height: 24,
    role: { en: "Messaging", ar: "المراسلة" },
    tone: "#e0d8ff",
    icon: true,
  },
  {
    name: "Bosta",
    src: "/logos/bosta.png",
    width: 112,
    height: 32,
    role: { en: "Carrier", ar: "شركة شحن" },
    tone: "#ffe9a8",
  },
  {
    name: "ShipBlu",
    src: "/logos/shipblu.png",
    width: 1967,
    height: 446,
    role: { en: "Carrier", ar: "شركة شحن" },
    tone: "#cff5dd",
  },
  {
    name: "J&T Express",
    src: "/logos/jnt.svg",
    width: 500,
    height: 105,
    role: { en: "Carrier", ar: "شركة شحن" },
    tone: "#ffd9cc",
  },
];
---

<section class="play-partners" id="partners" aria-labelledby="partners-title">
  <div class="site-frame">
    <div class="play-partners__panel">
      <div class="play-partners__head">
        <p class="eyebrow">
          <span data-copy="en">Partners</span>
          <span data-copy="ar" lang="ar">الشركاء</span>
        </p>
        <h2 class="play-partners__title" id="partners-title">
          <span data-copy="en">The tools behind every order.</span>
          <span data-copy="ar" lang="ar">الأدوات خلف كل طلب.</span>
        </h2>
        <p class="play-partners__copy">
          <span data-copy="en">Whano is built by Nomeda. Its app guide runs on Madar. Shopify, Meta, and your carrier keep the order moving.</span>
          <span data-copy="ar" lang="ar">Whano من إنتاج Nomeda. دليل التطبيق يعمل على Madar. ويتولى Shopify وMeta وشركة الشحن إدارة الطلب.</span>
        </p>
      </div>

      <ul class="play-partners__grid">
        {partners.map((partner) => (
          <li class="play-partners__card" style={`--tone: ${partner.tone};`}>
            <span class:list={["play-partners__logo", partner.icon && "play-partners__logo--icon"]}>
              <img
                src={partner.src}
                alt={partner.name}
                width={partner.width}
                height={partner.height}
                loading="lazy"
                decoding="async"
              />
            </span>
            <div>
              <p class="play-partners__name">{partner.name}</p>
              <p class="play-partners__role">
                <span data-copy="en">{partner.role.en}</span>
                <span data-copy="ar" lang="ar">{partner.role.ar}</span>
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .play-partners {
    padding-block: 72px 16px;
    background: #ffffff;
  }

  .play-partners__panel {
    padding: 38px 42px 42px;
    border: 1.5px solid var(--pl-line);
    border-radius: 40px;
    background:
      radial-gradient(540px 300px at 88% -10%, rgba(255, 213, 74, 0.26), transparent 70%),
      radial-gradient(560px 330px at 0% 110%, rgba(224, 216, 255, 0.62), transparent 72%),
      linear-gradient(135deg, #fffdf5 0%, #fbf9ff 55%, #f2fbf6 100%);
    box-shadow: 0 26px 60px rgba(22, 18, 43, 0.06);
  }

  .play-partners__head {
    max-width: 760px;
  }

  .play-partners__title {
    margin: 14px 0 12px;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .play-partners__copy {
    max-width: 680px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
    line-height: 1.85;
  }

  .play-partners__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
  }

  .play-partners__card {
    display: flex;
    flex: 1 1 200px;
    max-width: 256px;
    min-height: 168px;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px;
    border: 1.5px solid var(--pl-line);
    border-top: 4px solid var(--tone);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.86);
  }

  .play-partners__logo {
    display: flex;
    min-height: 42px;
    align-items: center;
  }

  .play-partners__logo img {
    display: block;
    width: auto;
    max-width: 124px;
    max-height: 32px;
    height: auto;
    object-fit: contain;
  }

  .play-partners__logo--icon img {
    max-width: 32px;
    max-height: 32px;
  }

  .play-partners__name {
    margin: 14px 0 2px;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .play-partners__role {
    margin: 0;
    color: var(--ink-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  :global(html[data-language="ar"]) .play-partners__title {
    letter-spacing: -0.02em;
    line-height: 1.42;
  }

  @media (max-width: 900px) {
    .play-partners {
      padding-block: 54px 8px;
    }

    .play-partners__panel {
      padding: 30px 24px 30px;
      border-radius: 30px;
    }

    .play-partners__title {
      font-size: clamp(1.8rem, 7vw, 2.5rem);
    }

    .play-partners__copy {
      font-size: 14px;
    }

    .play-partners__grid {
      margin-top: 24px;
    }

    .play-partners__card {
      flex-basis: 180px;
      min-height: 150px;
      padding: 18px;
    }
  }

  @media (max-width: 520px) {
    .play-partners__card {
      flex-basis: 100%;
      max-width: none;
      min-height: 0;
    }

    .play-partners__logo {
      min-height: 34px;
    }
  }
</style>
