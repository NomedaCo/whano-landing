---
import { site } from "../data/content";
---

<section class="section section--compact">
  <div class="site-frame">
    <div class="control-container reveal">
      <p class="eyebrow">
        <span data-copy="en">{site.control.eyebrow.en}</span>
        <span data-copy="ar" lang="ar">{site.control.eyebrow.ar}</span>
      </p>

      <h2 class="section-title">
        <span data-copy="en">{site.control.title.en}</span>
        <span data-copy="ar" lang="ar">{site.control.title.ar}</span>
      </h2>

      <div class="control-points" style="margin-top: 36px">
        {site.control.points.map((point) => (
          <div class="control-point">
            <h3>
              <span data-copy="en">{point.title.en}</span>
              <span data-copy="ar" lang="ar">{point.title.ar}</span>
            </h3>
            <p>
              <span data-copy="en">{point.body.en}</span>
              <span data-copy="ar" lang="ar">{point.body.ar}</span>
            </p>
          </div>
        ))}
      </div>

      <div class="language-strip">
        <span class="language-strip__label">
          <span data-copy="en">The customer edits from the secure link</span>
          <span data-copy="ar" lang="ar">العميل بيعدّل الطلب من الرابط الآمن</span>
        </span>
        <div class="language-strip__line">
          <span data-copy="en">One-time link</span>
          <span data-copy="ar" lang="ar">رابط يعمل مرة واحدة</span>
          <span class="language-strip__arrow" aria-hidden="true">→</span>
          <span data-copy="en">New total, then submit once</span>
          <span data-copy="ar" lang="ar">إجمالي جديد، ثم إرسال مرة واحدة</span>
        </div>
      </div>
    </div>
  </div>
</section>
