---
---

<div class="cycle-phone" data-cycle-state="shopify">
  <div class="phone-frame wf-phone-device">
    <div class="phone-screen">
      <div class="phone-statusbar">
        <span class="phone-statusbar__time">9:41</span>
        <span class="phone-statusbar__icons">
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 10h2v4H1zm4-3h2v7H5zm4-3h2v10H9zm4-4h2v14h-2z"/></svg>
          <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3a9 9 0 019 9h-2a7 7 0 00-7-7V3zm0-3a12 12 0 0112 12h-2a10 10 0 00-10-10V0z"/></svg>
          <svg viewBox="0 0 24 12" fill="currentColor" aria-hidden="true"><rect x="0" y="1" width="20" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="3" width="14" height="6" rx="1" /><path d="M22 5v2a1 1 0 001-1 1 1 0 00-1-1z"/></svg>
        </span>
      </div>

      <div class="cycle-stage">
        <div class="cycle-screen cycle-screen--shopify">
          <div class="cycle-shopify">
            <div class="cycle-shopify__top">
              <img src="/shopify-glyph.svg" alt="" width="18" height="18" />
              <span class="cycle-shopify__app">Shopify</span>
              <span class="cycle-shopify__time">now</span>
            </div>

            <div class="cycle-shopify__card">
              <p class="cycle-shopify__kicker">
                <span data-copy="en">New order</span>
                <span data-copy="ar" lang="ar">طلب جديد</span>
              </p>
              <p class="cycle-shopify__order">#1056</p>
              <p class="cycle-shopify__item">The Collection Snowboard: Hydrogen × 1</p>
              <div class="cycle-shopify__row">
                <span class="cycle-shopify__total">USD 600</span>
                <span class="cycle-shopify__badge cycle-shopify__badge--pending">
                  <span data-copy="en">Payment pending</span>
                  <span data-copy="ar" lang="ar">بانتظار الدفع</span>
                </span>
                <span class="cycle-shopify__badge cycle-shopify__badge--paid">
                  <span data-copy="en">Paid</span>
                  <span data-copy="ar" lang="ar">مدفوع</span>
                </span>
              </div>
            </div>

            <button type="button" class="cycle-shopify__cta" id="cycle-send">
              <svg class="cycle-shopify__cta-icon cycle-shopify__cta-icon--pay" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2.5"/>
                <path d="M2 10h20"/>
              </svg>
              <svg class="cycle-shopify__cta-icon cycle-shopify__cta-icon--done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"/>
              </svg>
              <span class="cycle-shopify__cta-label cycle-shopify__cta-label--pay">
                <span data-copy="en">Complete payment</span>
                <span data-copy="ar" lang="ar">إتمام الدفع</span>
              </span>
              <span class="cycle-shopify__cta-label cycle-shopify__cta-label--done">
                <span data-copy="en">Payment completed</span>
                <span data-copy="ar" lang="ar">تم الدفع</span>
              </span>
            </button>
          </div>
        </div>

        <button type="button" class="cycle-notif" id="cycle-notif">
          <span class="cycle-notif__icon" aria-hidden="true">
            <img src="/whano-avatar.png" alt="" width="22" height="22" />
          </span>
          <span class="cycle-notif__body">
            <span class="cycle-notif__title">Whano · WhatsApp</span>
            <span class="cycle-notif__text">
              <span data-copy="en">Order #1056 confirmation is out — tap to review</span>
              <span data-copy="ar" lang="ar">أُرسل تأكيد الطلب #1056 — افتح للمراجعة</span>
            </span>
          </span>
          <span class="cycle-notif__time">now</span>
        </button>
      </div>

      <div class="cycle-screen cycle-screen--whatsapp">
        <div class="wa-app-header">
          <div class="wa-app-header__back" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 19l-7-7 7-7" />
            </svg>
          </div>
          <div class="wa-app-header__avatar" aria-hidden="true">
            <img src="/whano-avatar.png" alt="" width="30" height="30" />
          </div>
          <div class="wa-app-header__meta">
            <div class="wa-app-header__name-row">
              <span class="wa-app-header__name">Whano</span>
              <svg class="wa-app-header__verified" viewBox="0 0 16 16" fill="#25D366" aria-label="Verified Business">
                <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zm3.2 5.2L7 9.4 4.8 7.2a.8.8 0 0 0-1.1 1.1l2.8 2.8c.3.3.8.3 1.1 0l4.8-4.8a.8.8 0 1 0-1.2-1.1z"/>
              </svg>
            </div>
            <span class="wa-app-header__status">
              <span data-copy="en">online</span>
              <span data-copy="ar" lang="ar">متصل الآن</span>
            </span>
          </div>
        </div>

        <div class="wa-chat-canvas" id="cycle-chat">
          <div class="wa-date-pill">
            <span data-copy="en">TODAY</span>
            <span data-copy="ar" lang="ar">اليوم</span>
          </div>
          <div class="wa-stream" id="cycle-stream"></div>
        </div>

        <div class="wa-bottom-bar">
          <div class="wa-bottom-bar__input" dir="rtl" lang="ar">
            <span class="wa-bottom-bar__placeholder" id="cycle-placeholder">
              <span data-copy="en">Type a message...</span>
              <span data-copy="ar" lang="ar">اكتب رسالة...</span>
            </span>
            <span class="wa-bottom-bar__value" id="cycle-input"></span>
          </div>
          <div class="wa-bottom-bar__mic" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1-9c0-.55.45-1 1-1s1 .45 1 1v6c0 .55-.45 1-1 1s-1-.45-1-1V5z"/>
              <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ol class="cycle-track">
    <li class="is-active" data-cycle-progress="shopify">
      <span class="cycle-track__num">1</span>
      <span data-copy="en">Order in Shopify</span>
      <span data-copy="ar" lang="ar">الطلب على Shopify</span>
    </li>
    <li data-cycle-progress="notified">
      <span class="cycle-track__num">2</span>
      <span data-copy="en">WhatsApp notification</span>
      <span data-copy="ar" lang="ar">إشعار واتساب</span>
    </li>
    <li data-cycle-progress="chat">
      <span class="cycle-track__num">3</span>
      <span data-copy="en">Reply inside the chat</span>
      <span data-copy="ar" lang="ar">الرد من داخل الشات</span>
    </li>
  </ol>

  <button type="button" class="cycle-replay" id="cycle-replay">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M1 4v6h6M23 20v-6h-6"/>
      <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
    </svg>
    <span data-copy="en">Replay</span>
    <span data-copy="ar" lang="ar">إعادة</span>
  </button>
</div>

<script>
  import { workflows } from "../data/workflows";

  const ORDER = workflows[0].messages[0];
  const CONFIRM_REPLY = workflows[0].messages[2];
  const CANCEL_REPLY = workflows[1].messages[2];
  const EDIT_REQUEST = workflows[2].messages[2].text;
  const EDIT_REPLY = workflows[2].messages[3];
  const CANCEL_DONE =
    "شكراً لتوضيحك. تم إلغاء الطلب بالكامل ونتمنى نخدمك في المرة القادمة 🙏";

  const root = document.querySelector<HTMLElement>(".cycle-phone");
  const sendBtn = document.getElementById("cycle-send") as HTMLButtonElement | null;
  const notif = document.getElementById("cycle-notif");
  const replay = document.getElementById("cycle-replay");
  const chat = document.getElementById("cycle-chat");
  const stream = document.getElementById("cycle-stream");
  const input = document.getElementById("cycle-input");
  const placeholder = document.getElementById("cycle-placeholder");

  const progress = document.querySelectorAll<HTMLElement>("[data-cycle-progress]");

  let runId = 0;

  function setState(state: string) {
    if (!root) return;
    root.dataset.cycleState = state;
    progress.forEach((item) => {
      item.classList.toggle("is-active", item.dataset.cycleProgress === state);
    });
  }

  function scrollChat() {
    if (!chat) return;
    chat.scrollTo({ top: chat.scrollHeight, behavior: "smooth" });
  }

  function checkIcon() {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("class", "wa-bubble__check");
    svg.setAttribute("viewBox", "0 0 16 11");
    svg.innerHTML = `
      <path d="M11.07.66L5.4 7.09 2.74 4.43l-1.4 1.41L5.4 9.91l7.08-7.84z" fill="currentColor"/>
      <path d="M7.07.66L1.4 7.09l1.41 1.41L7.07 3.5l.7.7L9.18.66z" fill="currentColor" opacity="0.6"/>
    `;
    return svg;
  }

  function appendRow(text: string, side: "in" | "out", opts: { success?: boolean; badge?: string } = {}) {
    if (!stream) return;
    const row = document.createElement("div");
    row.className = `wa-row wa-row--${side} cycle-step`;

    const bubble = document.createElement("div");
    bubble.className = `wa-bubble ${opts.success ? "wa-bubble--success" : ""}`;

    const bubbleText = document.createElement("div");
    bubbleText.className = "wa-bubble__text";
    bubbleText.setAttribute("dir", "rtl");
    bubbleText.setAttribute("lang", "ar");
    bubbleText.textContent = text;

    const meta = document.createElement("span");
    meta.className = "wa-bubble__meta";
    meta.textContent = side === "in" ? "9:41" : "9:42";
    if (side === "out") meta.appendChild(checkIcon());

    bubble.appendChild(bubbleText);
    bubble.appendChild(meta);
    row.appendChild(bubble);

    if (opts.badge) {
      const badge = document.createElement("div");
      badge.className = "wa-sync-pill";
      badge.setAttribute("dir", "rtl");
      badge.setAttribute("lang", "ar");
      badge.innerHTML = `
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 8a7 7 0 0113.5-2.5M15 8a7 7 0 01-13.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M14 2v4h-4M2 14v-4h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>${opts.badge}</span>
      `;
      row.appendChild(badge);
    }

    stream.appendChild(row);
    requestAnimationFrame(() => row.classList.add("is-on"));
    scrollChat();
  }

  function appendChoices(labels: string[]) {
    if (!stream) return;
    const group = document.createElement("div");
    group.className = "wa-chip-group cycle-step";
    group.setAttribute("dir", "rtl");

    labels.forEach((label) => {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "wa-chip-btn";
      chip.textContent = label;
      chip.addEventListener("click", () => handleAction(label, group));
      group.appendChild(chip);
    });

    stream.appendChild(group);
    requestAnimationFrame(() => group.classList.add("is-on"));
    scrollChat();
  }

  function lockGroup(group: HTMLElement, chosen: string) {
    group.querySelectorAll<HTMLButtonElement>(".wa-chip-btn").forEach((chip) => {
      chip.disabled = true;
      if (chip.textContent?.trim() === chosen) {
        chip.classList.add("is-selected");
      } else {
        chip.classList.add("is-faded");
      }
    });
  }

  async function wait(ms: number, id: number) {
    await new Promise((resolve) => window.setTimeout(resolve, ms));
    return id === runId;
  }

  async function typeIntoInput(text: string, id: number) {
    if (!input || !placeholder) return false;
    placeholder.classList.add("is-hidden");
    input.classList.add("is-typing");
    input.textContent = "";

    for (let i = 1; i <= text.length; i++) {
      if (id !== runId) return false;
      input.textContent = text.slice(0, i);
      const ok = await wait(22, id);
      if (!ok) return false;
    }

    return true;
  }

  async function sendFromInput(text: string, id: number) {
    const typed = await typeIntoInput(text, id);
    if (!typed) return false;

    const beat = await wait(520, id);
    if (!beat) return false;

    if (input) {
      input.classList.remove("is-typing");
      input.textContent = "";
    }
    placeholder?.classList.remove("is-hidden");

    appendRow(text, "out");
    return true;
  }

  async function sendDirect(text: string, id: number) {
    const ok = await wait(280, id);
    if (!ok) return false;
    appendRow(text, "out");
    return true;
  }

  async function handleAction(label: string, group: HTMLElement) {
    if (group.dataset.locked === "true") return;
    group.dataset.locked = "true";
    lockGroup(group, label);

    const id = runId;

    if (label === "عايز أعدل") {
      const sent = await sendFromInput(EDIT_REQUEST, id);
      if (!sent) return;
      const ok = await wait(900, id);
      if (!ok) return;
      appendRow(EDIT_REPLY.text, "in", { badge: "← متزامن مع Shopify وشركة الشحن" });
      return;
    }

    if (label === "إلغاء الطلب") {
      const sent = await sendDirect(label, id);
      if (!sent) return;
      const ok = await wait(600, id);
      if (!ok) return;
      appendRow(CANCEL_REPLY.text, "in");
      appendChoices(CANCEL_REPLY.buttons ?? []);
      return;
    }

    if (label === "تأكيد الطلب") {
      const sent = await sendDirect(label, id);
      if (!sent) return;
      const ok = await wait(700, id);
      if (!ok) return;
      appendRow(CONFIRM_REPLY.text, "in", { success: true });
      return;
    }

    const sent = await sendDirect(label, id);
    if (!sent) return;
    const ok = await wait(600, id);
    if (!ok) return;
    appendRow(CANCEL_DONE, "in");
  }

  function openChat() {
    if (!stream) return;
    stream.innerHTML = "";
    runId += 1;

    if (input) {
      input.textContent = "";
      input.classList.remove("is-typing");
    }
    placeholder?.classList.remove("is-hidden");

    appendRow(ORDER.text, "in");
    appendChoices(ORDER.buttons ?? []);
    setState("chat");
  }

  sendBtn?.addEventListener("click", () => {
    if (sendBtn.classList.contains("is-done")) return;
    sendBtn.classList.add("is-done");
    sendBtn.disabled = true;
    document.querySelector(".cycle-shopify__card")?.classList.add("is-paid");
    window.setTimeout(() => setState("notified"), 850);
  });

  notif?.addEventListener("click", openChat);

  replay?.addEventListener("click", () => {
    runId += 1;
    if (stream) stream.innerHTML = "";
    if (input) {
      input.textContent = "";
      input.classList.remove("is-typing");
    }
    placeholder?.classList.remove("is-hidden");
    if (chat) chat.scrollTop = 0;

    if (sendBtn) {
      sendBtn.classList.remove("is-done");
      sendBtn.disabled = false;
    }
    document.querySelector(".cycle-shopify__card")?.classList.remove("is-paid");

    setState("shopify");
  });
</script>
