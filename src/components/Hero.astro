<section class="pt-28 pb-16 md:pt-36 md:pb-24">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="max-w-2xl">
      <p class="text-sm font-medium text-accent mb-4 tracking-wide uppercase">For Shopify merchants in Egypt</p>

      <h1 class="font-heading text-[2.75rem] md:text-[3.5rem] font-black text-text leading-[1.08] tracking-tight mb-5">
        Your customers text WhatsApp.<br/>
        <span class="text-accent">Whano replies.</span>
