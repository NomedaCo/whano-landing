---
import { site } from "../data/content";
import { workflows } from "../data/workflows";
import CyclePhone from "./CyclePhone.astro";
import PhoneMock from "./PhoneMock.astro";

const total = String(workflows.length).padStart(2, "0");
---

<section id="top" class="hero">
  <div class="site-frame">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">
          <span data-copy="en">{site.hero.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.hero.eyebrow.ar}</span>
        </p>

        <h1 class="hero-title">
          <span data-copy="en">
            {site.hero.titleLead.en}<br />
            <span class="hero-title__accent">{site.hero.titleAccent.en}</span>
          </span>
          <span data-copy="ar" lang="ar">
            {site.hero.titleLead.ar}<br />
            <span class="hero-title__accent">{site.hero.titleAccent.ar}</span>
          </span>
        </h1>

        <p class="hero-body">
          <span data-copy="en">{site.hero.body.en}</span>
          <span data-copy="ar" lang="ar">{site.hero.body.ar}</span>
        </p>

        <div class="hero-actions">
          <a href={site.accessUrl.en} data-access-link class="button-primary">
            <svg width="16" height="18" viewBox="0 0 109.5 124.5" fill="currentColor" class="shopify-btn-icon" aria-hidden="true">
              <path d="M74.7,14.8c0,0-1.4,0.4-3.7,1.1c-0.4-1.3-1-2.8-1.8-4.4c-2.6-5-6.5-7.7-11.1-7.7c0,0,0,0,0,0 c-0.3,0-0.6,0-1,0.1c-0.1-0.2-0.3-0.3-0.4-0.5c-2-2.2-4.6-3.2-7.7-3.1c-6,0.2-12,4.5-16.8,12.2c-3.4,5.4-6,12.2-6.7,17.5 c-6.9,2.1-11.7,3.6-11.8,3.7c-3.5,1.1-3.6,1.2-4,4.5C9.1,40.7,0,111.2,0,111.2l75.6,13.1V14.6C75.2,14.7,74.9,14.7,74.7,14.8z M57.2,20.2c-4,1.2-8.4,2.6-12.7,3.9c1.2-4.7,3.6-9.4,6.4-12.5c1.1-1.1,2.6-2.4,4.3-3.2C56.9,12,57.3,16.9,57.2,20.2z M49.1,4.3 c1.4,0,2.6,0.3,3.6,0.9c-1.6,0.8-3.2,2.1-4.7,3.6c-3.8,4.1-6.7,10.5-7.9,16.6c-3.6,1.1-7.2,2.2-10.5,3.2 C31.7,19.1,39.8,4.6,49.1,4.3z M37.4,59.3c0.4,6.4,17.3,7.8,18.3,22.9c0.7,11.9-6.3,20-16.4,20.6c-12.2,0.8-18.9-6.4-18.9-6.4 l2.6-11c0,0,6.7,5.1,12.1,4.7c3.5-0.2,4.8-3.1,4.7-5.1c-0.5-8.4-14.3-7.9-15.2-21.7C23.8,51.8,31.4,40.1,48.2,39 c6.5-0.4,9.8,1.2,9.8,1.2l-3.8,14.4c0,0-4.3-2-9.4-1.6C37.4,53.5,37.3,58.2,37.4,59.3z M61.2,19c0-3-0.4-7.3-1.8-10.9 c4.6,0.9,6.8,6,7.8,9.1C65.4,17.7,63.4,18.3,61.2,19z"/>
              <path d="M78.1,123.9l31.4-7.8c0,0-13.5-91.3-13.6-91.9c-0.1-0.6-0.6-1-1.1-1c-0.5,0-9.3-0.2-9.3-0.2s-5.4-5.2-7.4-7.2 V123.9z"/>
            </svg>
            <span data-copy="en">{site.hero.cta.en}</span>
            <span data-copy="ar" lang="ar">{site.hero.cta.ar}</span>
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" class="button-arrow-icon">
              <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href={site.consoleUrl.en} data-console-link class="hero-login">
            <span data-copy="en">{site.hero.loginCta.en}</span>
            <span data-copy="ar" lang="ar">{site.hero.loginCta.ar}</span>
            <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <span class="hero-note">
            <span data-copy="en">{site.hero.ctaNote.en}</span>
            <span data-copy="ar" lang="ar">{site.hero.ctaNote.ar}</span>
          </span>
          <a
            href={site.rating.url}
            target="_blank"
            rel="noreferrer"
            class="hero-rating"
            aria-label={`${site.rating.value} ${site.rating.label.en}`}
          >
            <span class="hero-rating__stars" aria-hidden="true">★★★★★</span>
            <bdi dir="ltr">{site.rating.value}</bdi>
            <span data-copy="en">{site.rating.label.en}</span>
            <span data-copy="ar" lang="ar">{site.rating.label.ar}</span>
          </a>
        </div>

        <div class="hero-trust-bar">
          <div class="hero-trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="hero-trust-icon" aria-hidden="true">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span class="hero-trust-text">
              <span data-copy="en">Instant setup with zero number hassle</span>
              <span data-copy="ar" lang="ar">جاهز فورًا من دون إعداد أرقام</span>
            </span>
          </div>

          <div class="hero-trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="hero-trust-icon" aria-hidden="true">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
            <span class="hero-trust-text">
              <span data-copy="en">100 free points to test it</span>
              <span data-copy="ar" lang="ar">100 نقطة مجانية للتجربة</span>
            </span>
          </div>

          <div class="hero-trust-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="hero-trust-icon" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="hero-trust-text">
              <span data-copy="en">Connected to your Shopify store</span>
              <span data-copy="ar" lang="ar">متصل بمتجرك على Shopify</span>
            </span>
          </div>
        </div>
      </div>

      <div class="hero-cycle reveal">
        <CyclePhone />
      </div>
    </div>
  </div>
</section>

<section id="demo" class="demo-band">
  <div class="site-frame">
    <div class="section-heading reveal">
      <div>
        <p class="eyebrow">
          <span data-copy="en">Real conversations</span>
          <span data-copy="ar" lang="ar">محادثات حقيقية</span>
        </p>
      </div>
      <div>
        <h2 class="section-title">
          <span data-copy="en">See the exact messages your customers receive.</span>
          <span data-copy="ar" lang="ar">شاهد الرسائل الحقيقية كما تُرسل إلى عملائك.</span>
        </h2>
        <p class="section-copy">
          <span data-copy="en">The exact messages Whano sends. Swipe the middle phone, or tap any quick-reply button inside it to test the automated replies.</span>
          <span data-copy="ar" lang="ar">رسائل حقيقية من تطبيق Whano كما تصل إلى عملائك. اسحب الهاتف في المنتصف، أو اضغط على أي زر داخل المحادثة لتجربة الردود الفورية.</span>
        </p>
      </div>
    </div>

    <div class="hero-demo reveal">
      <div class="hero-demo__deck">
        <div class="hero-demo__item hero-demo__item--side" aria-hidden="true">
          <PhoneMock streamId="wa-stream-prev" />
          <p class="hero-demo__caption">
            <span class="hero-demo__caption-num" id="wf-prev-num">06</span>
            <span id="wf-prev-label-en" data-copy="en">{workflows[workflows.length - 1].tabLabel.en}</span>
            <span id="wf-prev-label-ar" data-copy="ar" lang="ar">{workflows[workflows.length - 1].tabLabel.ar}</span>
          </p>
        </div>

        <div class="hero-demo__item hero-demo__item--active" id="wf-swipe-surface">
          <PhoneMock
            streamId="wa-messages-stream"
            statusId="wa-header-status"
            typingId="wa-typing-indicator"
            replay
          />

          <button type="button" class="hero-demo__arrow hero-demo__arrow--prev" id="wf-prev-btn" aria-label="Previous conversation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button type="button" class="hero-demo__arrow hero-demo__arrow--next" id="wf-next-btn" aria-label="Next conversation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <div class="hero-demo__item hero-demo__item--side" aria-hidden="true">
          <PhoneMock streamId="wa-stream-next" />
          <p class="hero-demo__caption">
            <span class="hero-demo__caption-num" id="wf-next-num">02</span>
            <span id="wf-next-label-en" data-copy="en">{workflows[1].tabLabel.en}</span>
            <span id="wf-next-label-ar" data-copy="ar" lang="ar">{workflows[1].tabLabel.ar}</span>
          </p>
        </div>
      </div>

      <div class="hero-demo__dots" role="group" aria-label="Conversations">
        {workflows.map((wf, idx) => (
          <button
            type="button"
            class:list={["hero-demo__dot", idx === 0 && "is-active"]}
            data-wf-dot={idx}
            aria-label={`${wf.number} — ${wf.tabLabel.en}`}
          ></button>
        ))}
      </div>

      <div class="hero-demo__text">
        <p class="hero-demo__label">
          <span class="hero-demo__count"><span id="wf-scenario-num">01</span> / {total}</span>
          <span class="hero-demo__title" id="wf-scenario-title">
            <span id="wf-title-en" data-copy="en">{workflows[0].tabLabel.en}</span>
            <span id="wf-title-ar" data-copy="ar" lang="ar">{workflows[0].tabLabel.ar}</span>
          </span>
        </p>
        <p class="hero-demo__desc">
          <span id="wf-desc-en" data-copy="en">{workflows[0].description.en}</span>
          <span id="wf-desc-ar" data-copy="ar" lang="ar">{workflows[0].description.ar}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { workflows, msgText, msgButtons, msgBadge } from "../data/workflows";

  const currentLang = () => (document.documentElement.dataset.language === "en" ? "en" : "ar");
  const L = (ar: string, en: string) => (currentLang() === "en" ? en : ar);

  /** Both languages map to one key, so the reply logic never parses text. */
  const BUTTON_KEYS: Record<string, string> = {
    "تأكيد الطلب": "confirm", "Confirm order": "confirm",
    "إلغاء الطلب": "cancel", "Cancel order": "cancel",
    "عايز أعدل": "edit", "I want to edit": "edit",
    "السعر مرتفع": "price", "Price is high": "price",
    "غيرت رأيي": "mind", "Changed my mind": "mind",
    "سبب آخر": "reason", "Another reason": "reason",
    "ممتاز": "great", "Excellent": "great",
    "جيد": "good", "Good": "good",
    "سيء": "bad", "Bad": "bad",
    "استبدال": "exchange", "Exchange": "exchange",
    "استرجاع": "refund", "Refund": "refund",
    "مشكلة أخرى": "issue", "Another issue": "issue",
  };

  const cancelReasons = () => [L("السعر مرتفع", "Price is high"), L("غيرت رأيي", "Changed my mind"), L("سبب آخر", "Another reason")];
  const supportOptions = () => [L("استبدال", "Exchange"), L("استرجاع", "Refund"), L("مشكلة أخرى", "Another issue")];
  const ticketBadge = () => L("← تم فتح تذكرة الدعم #W-1005 وإخطار التاجر", "← Support ticket #W-1005 opened and the merchant notified");
  const ticketLong = () =>
    L(
      "تم فتح تذكرة الدعم #W-1005.\nاتواصل مع خدمة العملاء على الرقم ده:\n+20 1001580461\n• يمكن للعميل طلب استبدال المنتج خلال 14 يومًا من تاريخ استلامه.\n• عند طلب الاستبدال، يتم فتح تذكرة دعم تلقائيًا وإخطار التاجر.\n• قبول أو رفض طلب الاستبدال يخضع لسياسة المتجر وشروط المنتج.\n• يجب أن يكون المنتج في حالته الأصلية وبالتغليف الأصلي.\nبعد مرور 14 يومًا من تاريخ الاستلام، لا يمكن للعميل تقديم طلب استبدال من خلال Whano.\n• سيتواصل فريق خدمة العملاء مع العميل من رقم الدعم المسجل لدى المتجر.",
      "Support ticket #W-1005 is open.\nReach customer service on this number:\n+20 1001580461\n• A customer may request an exchange within 14 days of receiving the item.\n• An exchange request opens a support ticket automatically and notifies the merchant.\n• Accepting or refusing the exchange follows the store's policy and the item's condition.\n• The item must be in its original condition and packaging.\nAfter 14 days from delivery, a customer cannot request an exchange through Whano.\n• Customer service will contact the customer from the store's registered support number.",
    );
  const ticketShort = () =>
    L(
      "تم فتح تذكرة الدعم #W-1005.\nاتواصل مع خدمة العملاء على الرقم ده:\n+20 1001580461",
      "Support ticket #W-1005 is open.\nReach customer service on this number:\n+20 1001580461",
    );

  let activeIndex = 0;
  let activeTimers: number[] = [];
  let userInteracted = false;

  const prevBtn = document.getElementById("wf-prev-btn");
  const nextBtn = document.getElementById("wf-next-btn");
  const replayBtn = document.getElementById("wf-replay-btn");
  const swipeSurface = document.getElementById("wf-swipe-surface");

  const activeStream = document.getElementById("wa-messages-stream");
  const prevStream = document.getElementById("wa-stream-prev");
  const nextStream = document.getElementById("wa-stream-next");

  const scenarioNum = document.getElementById("wf-scenario-num");
  const titleEn = document.getElementById("wf-title-en");
  const titleAr = document.getElementById("wf-title-ar");
  const descEn = document.getElementById("wf-desc-en");
  const descAr = document.getElementById("wf-desc-ar");
  const dots = document.querySelectorAll<HTMLButtonElement>("[data-wf-dot]");

  const prevNum = document.getElementById("wf-prev-num");
  const nextNum = document.getElementById("wf-next-num");
  const prevLabelEn = document.getElementById("wf-prev-label-en");
  const prevLabelAr = document.getElementById("wf-prev-label-ar");
  const nextLabelEn = document.getElementById("wf-next-label-en");
  const nextLabelAr = document.getElementById("wf-next-label-ar");

  const typingIndicator = document.getElementById("wa-typing-indicator");
  const headerStatus = document.getElementById("wa-header-status");

  function clearTimers() {
    activeTimers.forEach((t) => clearTimeout(t));
    activeTimers = [];
  }

  function setHeaderTyping(isTyping: boolean) {
    if (!headerStatus) return;
    headerStatus.innerHTML = isTyping
      ? `<span data-copy="en">typing...</span><span data-copy="ar" lang="ar">يكتب الآن...</span>`
      : `<span data-copy="en">online</span><span data-copy="ar" lang="ar">متصل الآن</span>`;
  }

  function scrollStream(stream: HTMLElement, behavior: ScrollBehavior = "auto") {
    const canvas = stream.closest(".wa-chat-canvas");
    if (!canvas) return;
    canvas.scrollTo({ top: canvas.scrollHeight, behavior });
  }

  function renderBubble(
    msg: {
      sender: "whano" | "customer";
      text: string;
      buttons?: string[];
      success?: boolean;
      badge?: string;
    },
    interactive = true
  ): HTMLElement {
    const row = document.createElement("div");
    row.className = `wa-row ${msg.sender === "whano" ? "wa-row--in" : "wa-row--out"}`;

    const bubble = document.createElement("div");
    bubble.className = `wa-bubble ${msg.success ? "wa-bubble--success" : ""}`;

    const language = currentLang();
    const text = document.createElement("div");
    text.className = "wa-bubble__text";
    text.setAttribute("dir", language === "en" ? "ltr" : "rtl");
    text.setAttribute("lang", language);
    text.textContent = msgText(msg, language);

    const meta = document.createElement("span");
    meta.className = "wa-bubble__meta";
    meta.textContent = msg.sender === "whano" ? "9:41" : "9:42";

    if (msg.sender === "customer") {
      const check = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      check.setAttribute("class", "wa-bubble__check");
      check.setAttribute("viewBox", "0 0 16 11");
      check.innerHTML = `
        <path d="M11.07.66L5.4 7.09 2.74 4.43l-1.4 1.41L5.4 9.91l7.08-7.84z" fill="currentColor"/>
        <path d="M7.07.66L1.4 7.09l1.41 1.41L7.07 3.5l.7.7L9.18.66z" fill="currentColor" opacity="0.6"/>
      `;
      meta.appendChild(check);
    }

    bubble.appendChild(text);
    bubble.appendChild(meta);
    row.appendChild(bubble);

    const labels = msgButtons(msg, language);
    if (labels.length > 0) {
      const btnGroup = document.createElement("div");
      btnGroup.className = "wa-chip-group";
      btnGroup.setAttribute("dir", language === "en" ? "ltr" : "rtl");

      labels.forEach((label) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "wa-chip-btn";
        btn.innerHTML = `
          <svg class="wa-chip-btn__icon" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>${label}</span>
        `;

        if (interactive) {
          btn.addEventListener("click", () => handleButtonTap(label, btnGroup));
        } else {
          btn.disabled = true;
          btn.tabIndex = -1;
        }

        btnGroup.appendChild(btn);
      });

      row.appendChild(btnGroup);
    }

    const badgeText = msgBadge(msg, language);
    if (badgeText) {
      const badgeEl = document.createElement("div");
      badgeEl.className = "wa-sync-pill";
      badgeEl.setAttribute("dir", language === "en" ? "ltr" : "rtl");
      badgeEl.setAttribute("lang", language);
      badgeEl.innerHTML = `
        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 8a7 7 0 0113.5-2.5M15 8a7 7 0 01-13.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <path d="M14 2v4h-4M2 14v-4h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>${badgeText}</span>
      `;
      row.appendChild(badgeEl);
    }

    return row;
  }

  function handleButtonTap(buttonText: string, groupEl?: HTMLElement) {
    userInteracted = true;
    clearTimers();

    if (groupEl) {
      groupEl.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
        b.disabled = true;
        if (b.textContent?.includes(buttonText)) {
          b.classList.add("is-selected");
        } else {
          b.classList.add("is-faded");
        }
      });
    }

    const userMsg = renderBubble({
      sender: "customer",
      text: buttonText,
    });
    activeStream?.appendChild(userMsg);
    if (activeStream) scrollStream(activeStream, "smooth");

    showTyping(450, () => {
      const key = BUTTON_KEYS[buttonText];
      let reply: { text: string; success?: boolean; buttons?: string[]; badge?: string } | null = null;

      if (key === "confirm") {
        reply = { text: L("تم تأكيد طلبك #1056!", "Order #1056 is confirmed!"), success: true };
      } else if (key === "cancel") {
        reply = {
          text: L("تم إلغاء طلبك #1056.\n\nممكن نعرف السبب؟", "Order #1056 is cancelled.\n\nMay we know why?"),
          buttons: cancelReasons(),
        };
      } else if (key === "edit") {
        const editReq = renderBubble({
          sender: "customer",
          text: L("عايز أزود واحد من نفس المنتج", "I want to add one more of the same item"),
        });
        activeStream?.appendChild(editReq);
        if (activeStream) scrollStream(activeStream, "smooth");

        showTyping(650, () => {
          const editConfirm = renderBubble({
            sender: "whano",
            text: L(
              "تم تعديل الطلب ✅\n\nThe Collection Snowboard: Hydrogen × 2\nالإجمالي الجديد: USD 1,200",
              "Order updated ✅\n\nThe Collection Snowboard: Hydrogen × 2\nNew total: USD 1,200",
            ),
            badge: L("← متزامن مع Shopify وشركة الشحن", "← Synced with Shopify and the carrier"),
          });
          activeStream?.appendChild(editConfirm);
          if (activeStream) scrollStream(activeStream, "smooth");
        });
        return;
      } else if (key === "price" || key === "mind" || key === "reason") {
        reply = {
          text: L(
            "شكراً لتوضيحك. تم إلغاء الطلب بالكامل ونتمنى نخدمك في المرة القادمة 🙏",
            "Thanks for explaining. The order is fully cancelled — we hope to serve you again 🙏",
          ),
        };
      } else if (key === "great" || key === "good") {
        reply = {
          text: L(
            "شكراً لتقييمك! سعداء جداً بتجربتك معنا وبطلبك القادم 🎉",
            "Thank you for the rating! We're glad you enjoyed it — see you on your next order 🎉",
          ),
          success: true,
        };
      } else if (key === "bad") {
        reply = {
          text: L("أنا آسف إن التجربة ما كانتش كويسة. إيه المشكلة اللي حصلت؟", "Sorry the experience was not good. What went wrong?"),
          buttons: supportOptions(),
        };
      } else if (key === "exchange" || key === "refund") {
        reply = { text: ticketLong(), badge: ticketBadge() };
      } else if (key === "issue") {
        reply = { text: ticketShort(), badge: ticketBadge() };
      }

      if (reply) {
        const replyEl = renderBubble({ sender: "whano", ...reply });
        activeStream?.appendChild(replyEl);
        if (activeStream) scrollStream(activeStream, "smooth");
      }
    });
  }

  // Toggling the language re-renders the visible conversation: the bubbles are
  // built in JS, so the data-copy spans that switch the rest of the page do
  // not reach them.
  window.addEventListener("whano:language", () => {
    if (activeStream) renderStatic(activeStream, workflows[activeIndex].messages);
    if (prevStream) renderStatic(prevStream, workflows[(activeIndex - 1 + workflows.length) % workflows.length].messages);
    if (nextStream) renderStatic(nextStream, workflows[(activeIndex + 1) % workflows.length].messages);
    setHeaderTyping(false);
  });

  function showTyping(duration: number, callback: () => void) {
    if (typingIndicator) {
      typingIndicator.classList.add("is-visible");
      setHeaderTyping(true);
      if (activeStream) scrollStream(activeStream, "smooth");
    }

    const timer = window.setTimeout(() => {
      if (typingIndicator) {
        typingIndicator.classList.remove("is-visible");
        setHeaderTyping(false);
      }
      callback();
    }, duration);

    activeTimers.push(timer);
  }

  function renderStatic(stream: HTMLElement, messages: typeof workflows[number]["messages"]) {
    stream.innerHTML = "";
    messages.forEach((msg) => stream.appendChild(renderBubble(msg, false)));
    requestAnimationFrame(() => scrollStream(stream));
  }

  function playWorkflow(index: number) {
    clearTimers();
    if (!activeStream) return;

    activeStream.innerHTML = "";
    if (typingIndicator) typingIndicator.classList.remove("is-visible");
    setHeaderTyping(false);

    const wf = workflows[index];
    if (!wf || !wf.messages) return;

    userInteracted = false;
    let delay = 200;

    wf.messages.forEach((msg, msgIdx) => {
      const isIncoming = msg.sender === "whano";

      if (isIncoming && msgIdx > 0) {
        const tTyping = window.setTimeout(() => {
          if (userInteracted) return;
          showTyping(550, () => {
            if (userInteracted) return;
            const el = renderBubble(msg);
            activeStream.appendChild(el);
            scrollStream(activeStream, "smooth");
          });
        }, delay);
        activeTimers.push(tTyping);
        delay += 1050;
      } else {
        const tMsg = window.setTimeout(() => {
          if (userInteracted) return;
          const el = renderBubble(msg);
          activeStream.appendChild(el);
          scrollStream(activeStream, "smooth");
        }, delay);
        activeTimers.push(tMsg);
        delay += msg.buttons ? 950 : 750;
      }
    });
  }

  function selectWorkflow(index: number) {
    if (index < 0) index = workflows.length - 1;
    if (index >= workflows.length) index = 0;

    activeIndex = index;
    const wf = workflows[index];
    const prevWf = workflows[(index - 1 + workflows.length) % workflows.length];
    const nextWf = workflows[(index + 1) % workflows.length];

    if (scenarioNum) scenarioNum.textContent = wf.number;
    if (titleEn) titleEn.textContent = wf.tabLabel.en;
    if (titleAr) titleAr.textContent = wf.tabLabel.ar;
    if (descEn) descEn.textContent = wf.description.en;
    if (descAr) descAr.textContent = wf.description.ar;

    if (prevNum) prevNum.textContent = prevWf.number;
    if (nextNum) nextNum.textContent = nextWf.number;
    if (prevLabelEn) prevLabelEn.textContent = prevWf.tabLabel.en;
    if (prevLabelAr) prevLabelAr.textContent = prevWf.tabLabel.ar;
    if (nextLabelEn) nextLabelEn.textContent = nextWf.tabLabel.en;
    if (nextLabelAr) nextLabelAr.textContent = nextWf.tabLabel.ar;

    dots.forEach((dot, i) => {
      dot.classList.toggle("is-active", i === index);
    });

    if (prevStream) renderStatic(prevStream, prevWf.messages);
    if (nextStream) renderStatic(nextStream, nextWf.messages);

    playWorkflow(index);
  }

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      selectWorkflow(Number(dot.dataset.wfDot));
    });
  });

  prevBtn?.addEventListener("click", () => selectWorkflow(activeIndex - 1));
  nextBtn?.addEventListener("click", () => selectWorkflow(activeIndex + 1));

  replayBtn?.addEventListener("click", () => {
    replayBtn.classList.add("is-spinning");
    setTimeout(() => replayBtn.classList.remove("is-spinning"), 500);
    playWorkflow(activeIndex);
  });

  const surface = swipeSurface;

  function resetSurface() {
    if (!surface) return;
    surface.style.transition = "";
    surface.style.transform = "";
  }

  let startX = 0;
  let startY = 0;
  let tracking = false;
  let horizontal = false;
  let suppressClick = false;

  surface?.addEventListener("pointerdown", (event) => {
    if ((event.target as HTMLElement).closest(".hero-demo__arrow")) return;
    if (event.pointerType === "mouse" && event.button !== 0) return;
    tracking = true;
    horizontal = false;
    startX = event.clientX;
    startY = event.clientY;
  });

  surface?.addEventListener("pointermove", (event) => {
    if (!tracking || !surface) return;

    const dx = event.clientX - startX;
    const dy = event.clientY - startY;

    if (!horizontal) {
      if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
      if (Math.abs(dx) <= Math.abs(dy) * 1.2) {
        tracking = false;
        return;
      }
      horizontal = true;
      surface.style.transition = "none";
      surface.setPointerCapture(event.pointerId);
    }

    surface.style.transform = `translateX(${dx * 0.28}px)`;
  });

  function endDrag(event: PointerEvent) {
    if (!tracking) return;
    tracking = false;

    if (!horizontal) return;
    horizontal = false;

    const dx = event.clientX - startX;
    resetSurface();

    suppressClick = true;
    window.setTimeout(() => {
      suppressClick = false;
    }, 80);

    const rtl = document.documentElement.dir === "rtl";
    const advance = rtl ? dx : -dx;

    if (advance > 60) {
      selectWorkflow(activeIndex + 1);
    } else if (advance < -60) {
      selectWorkflow(activeIndex - 1);
    }
  }

  surface?.addEventListener("pointerup", endDrag);
  surface?.addEventListener("pointercancel", () => {
    tracking = false;
    horizontal = false;
    resetSurface();
  });

  surface?.addEventListener(
    "click",
    (event) => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
    },
    true
  );

  function setupAutoTrigger() {
    const demo = document.querySelector(".hero-demo");
    if (!demo || !("IntersectionObserver" in window)) return;

    let hasStarted = false;
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !hasStarted) {
            hasStarted = true;
            obs.unobserve(demo);
            selectWorkflow(0);
          }
        });
      },
      { threshold: 0.2 }
    );

    obs.observe(demo);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      selectWorkflow(0);
      setupAutoTrigger();
    });
  } else {
    selectWorkflow(0);
    setupAutoTrigger();
  }
</script>
