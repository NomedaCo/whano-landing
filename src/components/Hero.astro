---
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Subtle glow behind the mockup -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="mx-auto max-w-6xl px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Copy -->
      <div class="reveal">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-accent/10 border border-accent/20 rounded-full mb-6">
          <span class="w-1.5 h-1.5 bg-accent rounded-full"></span>
          <span class="text-xs font-medium text-accent tracking-wide uppercase">For Shopify merchants</span>
        </div>

        <h1 class="font-heading text-4xl md:text-5xl lg:text-[3.5rem] font-bold text-text-primary leading-[1.1] tracking-tight mb-6">
          Your customers text WhatsApp.
          <span class="text-accent">Whano replies.</span>
        </h1>

        <p class="text-lg text-text-secondary leading-relaxed mb-8 max-w-lg">
          Order confirmations, shipping updates, review collection, and smart upsells — all automated through WhatsApp. Built for Egyptian Shopify merchants.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 mb-8">
          <a
            href="https://apps.shopify.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent text-bg-base font-semibold rounded-lg hover:bg-accent-hover transition-colors duration-200"
          >
            Install on Shopify
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-text-muted">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            No credit card
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            50 free messages
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
            </svg>
            Setup in 5 minutes
          </span>
        </div>
      </div>

      <!-- Right: WhatsApp Mockup -->
      <div class="reveal lg:justify-self-end">
        <div class="whatsapp-mockup max-w-md mx-auto lg:mx-0 shadow-lg shadow-black/20">
          <!-- Header -->
          <div class="whatsapp-header">
            <div class="w-8 h-8 rounded-full bg-accent/20 flex items-center justify-center">
              <span class="text-accent font-heading font-bold text-xs">W</span>
            </div>
            <div>
              <p class="text-sm font-medium text-[#E9EDEF]">Whano</p>
              <p class="text-xs text-[#8696A0]">online</p>
            </div>
          </div>

          <!-- Messages -->
          <div class="whatsapp-body">
            <div class="msg-customer msg-animate msg-delay-1">
              بتأكيد الطلب #1042
            </div>
            <div class="msg-bot msg-animate msg-delay-2">
              أهلاً أحمد! تم تأكيد طلبك #1042 ✅<br /><br />
              2x تيشيرت قطن — 360 ج.م<br />
              الشحن — 50 ج.م<br />
              <strong>الإجمالي — 410 ج.م</strong><br /><br />
              هيوصلك خلال 2-3 أيام عمل.
            </div>
            <div class="msg-customer msg-animate msg-delay-3">
              ممكن اضيف تيشيرت تاني؟
            </div>
            <div class="msg-bot msg-animate msg-delay-4">
              أكيد! تيشيرت قطن إضافي — 180 ج.م<br /><br />
              هنضيفه على طلبك؟
            </div>
            <div class="msg-customer msg-animate msg-delay-5">
              اه ياريت
            </div>
            <div class="msg-bot msg-animate msg-delay-6">
              تم! طلبك #1042 اتحدث<br />
              <strong>الإجمالي الجديد — 590 ج.م</strong> 🎉
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Intersection Observer for reveal animations
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
</script>
