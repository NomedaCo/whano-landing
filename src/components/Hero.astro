---
import ChatThread from "./ChatThread.astro";
import { heroConversation, site } from "../data/content";
---

<section id="top" class="hero">
  <div class="site-frame">
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">
          <span data-copy="en">{site.hero.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.hero.eyebrow.ar}</span>
        </p>

        <h1 class="hero-title">
          <span data-copy="en">
            {site.hero.titleLead.en}<br />
            <span class="hero-title__accent">{site.hero.titleAccent.en}</span>
          </span>
          <span data-copy="ar" lang="ar">
            {site.hero.titleLead.ar}<br />
            <span class="hero-title__accent">{site.hero.titleAccent.ar}</span>
          </span>
        </h1>

        <p class="hero-body">
          <span data-copy="en">{site.hero.body.en}</span>
          <span data-copy="ar" lang="ar">{site.hero.body.ar}</span>
        </p>

        <div class="hero-actions">
          <a href={site.accessUrl.en} data-access-link class="button-primary">
            <span data-copy="en">{site.hero.cta.en}</span>
            <span data-copy="ar" lang="ar">{site.hero.cta.ar}</span>
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
              <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <span class="hero-note">
            <span data-copy="en">{site.hero.ctaNote.en}</span>
            <span data-copy="ar" lang="ar">{site.hero.ctaNote.ar}</span>
          </span>
        </div>

        <ul class="proof-list">
          {site.hero.proofs.map((proof) => (
            <li class="proof-item">
              <span class="proof-mark" aria-hidden="true"></span>
              <span data-copy="en">{proof.en}</span>
              <span data-copy="ar" lang="ar">{proof.ar}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-visual reveal">
        <div class="order-sheet">
          <div class="sheet-header">
            <div>
              <div class="sheet-label">Whano / 1042</div>
              <div class="sheet-title">
                <span data-copy="en">Order conversation</span>
                <span data-copy="ar" lang="ar">محادثة الطلب</span>
              </div>
            </div>
              <div class="sheet-status">
              <span data-copy="en">{site.thread.orderStatus.en}</span>
              <span data-copy="ar" lang="ar">{site.thread.orderStatus.ar}</span>
            </div>
          </div>

          <div class="sheet-body">
            <div class="sheet-caption">
              <span class="sheet-caption__side">Shopify → WhatsApp</span>
              <span class="sheet-caption__side">
                <span data-copy="en">{site.thread.label.en}</span>
                <span data-copy="ar" lang="ar">{site.thread.label.ar}</span>
              </span>
            </div>
            <ChatThread messages={heroConversation} />
          </div>

          <div class="sheet-footer">
            <span>Shopify</span>
            <span>WhatsApp</span>
            <span>EGP</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
