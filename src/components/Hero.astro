      <p class="text-lg text-body leading-relaxed mb-7 max-w-lg">
        Order confirmations, shipping updates, review collection, and product recommendations — all automated through WhatsApp. Speaks Arabic and English.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 mb-7">
        <a href="https://apps.shopify.com/" target="_blank" rel="noopener noreferrer"
           class="h-11 px-6 inline-flex items-center justify-center gap-2 bg-accent text-bg font-semibold rounded-lg hover:bg-accent-hover transition-colors text-sm">
          Install on Shopify — Free
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

