---
import Base from "../../../layouts/Base.astro";
import CTA from "../../../components/CTA.astro";
import Footer from "../../../components/Footer.astro";
import MobileCta from "../../../components/MobileCta.astro";
import Nav from "../../../components/Nav.astro";
import { guides } from "../../../data/guides";

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug } }));
}

const { slug } = Astro.params;
const guide = guides.find((entry) => entry.slug === slug);
if (!guide) throw new Error(`Unknown guide: ${slug}`);

const published = guide.published;
const publishedDate = new Date(`${published}T00:00:00Z`);
const publishedEn = publishedDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const publishedAr = publishedDate.toLocaleDateString("ar-EG", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const isEnglish = /^\/en(?:\/|$)/.test(Astro.url.pathname);
const articleUrl = new URL(`${isEnglish ? "/en" : ""}/guides/${guide.slug}/`, Astro.site).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: isEnglish ? guide.title.en : guide.title.ar,
  description: isEnglish ? guide.description.en : guide.description.ar,
  inLanguage: isEnglish ? "en" : "ar",
  datePublished: published,
  dateModified: published,
  mainEntityOfPage: articleUrl,
  author: { "@type": "Organization", name: "NomedaCo", url: "https://nomeda.tech" },
  publisher: {
    "@type": "Organization",
    name: "NomedaCo",
    url: "https://nomeda.tech",
    logo: { "@type": "ImageObject", url: new URL("/icon-512.png", Astro.site).href },
  },
  image: new URL("/og.png", Astro.site).href,
};
---

<Base
  title={`${guide.title.en} | Whano`}
  titleArabic={`${guide.title.ar} | Whano`}
  description={guide.description.en}
  descriptionArabic={guide.description.ar}
  ogType="article"
  publishedTime={published}
  modifiedTime={published}
  schema={articleSchema}
>
  <Nav />
  <main id="main-content" class="about-page">
    <div class="site-frame">
      <header class="about-header reveal">
        <p class="eyebrow">
          <span data-copy="en">Whano / guides</span>
          <span data-copy="ar" lang="ar">Whano / شرح عملي</span>
        </p>
        <h1 class="about-title">
          <span data-copy="en">{guide.title.en}</span>
          <span data-copy="ar" lang="ar">{guide.title.ar}</span>
        </h1>
        <p class="about-subtitle">
          <span data-copy="en">{guide.intro.en}</span>
          <span data-copy="ar" lang="ar">{guide.intro.ar}</span>
        </p>
        <p class="guide-meta">
          <span data-copy="en">{guide.readingTime.en}</span>
          <span data-copy="ar" lang="ar">{guide.readingTime.ar}</span>
          <span aria-hidden="true">·</span>
          <time datetime={published}>
            <span data-copy="en">Published {publishedEn}</span>
            <span data-copy="ar" lang="ar">نُشر في {publishedAr}</span>
          </time>
        </p>
      </header>

      {guide.sections.map((section) => (
        <section class="about-section reveal">
          <h2 class="about-section__heading">
            <span data-copy="en">{section.heading.en}</span>
            <span data-copy="ar" lang="ar">{section.heading.ar}</span>
          </h2>
          {section.body.map((paragraph) => (
            <p class="about-section__body">
              <span data-copy="en">{paragraph.en}</span>
              <span data-copy="ar" lang="ar">{paragraph.ar}</span>
            </p>
          ))}
        </section>
      ))}

      <p class="about-section__body reveal" style="margin-top: 28px;">
        <a href="/guides/" class="section-link">
          <span data-copy="en">All guides</span>
          <span data-copy="ar" lang="ar">كل الشروح</span>
          <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true">
            <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </p>
    </div>
  </main>
  <CTA />
  <MobileCta />
  <Footer />
</Base>
