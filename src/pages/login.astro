---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { site } from "../data/content";

const target = site.consoleUrl.en;
---

<Base
  title="Log in — Whano"
  titleArabic="تسجيل الدخول — Whano"
  description="The Whano console: orders, conversations, controls, and reports for your Shopify store."
  descriptionArabic="لوحة تحكم Whano: الطلبات، والمحادثات، والتحكم، والتقارير لمتجرك على Shopify."
>
  <Nav />
  <main id="main-content" class="about-page">
    <div class="site-frame">
      <header class="about-header reveal" style="text-align: center; margin-inline: auto;">
        <p class="eyebrow" style="justify-content: center;">
          <span data-copy="en">{site.loginPage.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.loginPage.eyebrow.ar}</span>
        </p>
        <h1 class="about-title">
          <span data-copy="en">{site.loginPage.title.en}</span>
          <span data-copy="ar" lang="ar">{site.loginPage.title.ar}</span>
        </h1>
        <p class="about-subtitle">
          <span data-copy="en">{site.loginPage.body.en}</span>
          <span data-copy="ar" lang="ar">{site.loginPage.body.ar}</span>
        </p>
        <p style="margin-top: 28px;">
          <a href={target} class="button-primary">
            <span data-copy="en">{site.loginPage.button.en}</span>
            <span data-copy="ar" lang="ar">{site.loginPage.button.ar}</span>
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true" class="button-arrow-icon">
              <path d="M2.5 7.5h9M8 3.5l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </p>
      </header>
    </div>
  </main>
  <Footer />
  <script is:inline define:vars={{ target }}>
    // A typed address should not sit on a dead-end page: go straight to the
    // console, which itself decides between the overview and the login form.
    window.location.replace(target);
  </script>
</Base>
