---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Control from "../components/Control.astro";
import FAQ from "../components/FAQ.astro";
import Features from "../components/Features.astro";
import Flow from "../components/Flow.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import Problem from "../components/Problem.astro";
---

<Base
  title="Whano — WhatsApp operations for Shopify"
  titleArabic="Whano — إدارة طلبات Shopify على واتساب"
  description="Whano keeps Shopify orders moving on WhatsApp with clear confirmations, updates, and follow-up for Egyptian merchants."
  descriptionArabic="Whano بيساعد التجار على Shopify يتابعوا الطلبات على واتساب بالتأكيدات والتحديثات والمتابعة."
>
  <Nav />
  <main id="main-content">
    <Hero />
    <Problem />
    <Flow />
    <Features />
    <Control />
    <Pricing />
    <FAQ />
    <CTA />
  </main>
  <Footer />
</Base>
