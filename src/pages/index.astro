---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Nav from "../components/Nav.astro";
import Pricing from "../components/Pricing.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
---

<Base
  title="Whano | WhatsApp operations for Shopify"
  titleArabic="Whano | إدارة طلبات Shopify على واتساب"
  description="Whano keeps Shopify orders moving on WhatsApp with clear confirmations, updates, and follow-up for Egyptian merchants."
  descriptionArabic="Whano بيساعد التجار على Shopify يتابعوا الطلبات على واتساب بالتأكيدات والتحديثات والمتابعة."
>
  <Nav />
  <main id="main-content">
    <Hero />
    <Features />
    <WorkflowShowcase />
    <Pricing />
    <CTA />
  </main>
  <Footer />
</Base>
