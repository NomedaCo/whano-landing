---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import MobileCta from "../components/MobileCta.astro";
import Nav from "../components/Nav.astro";
import { site } from "../data/content";

const nomedaProducts = [
  { name: "Nomeda", src: "/logos/nomeda.svg", width: 196, height: 48, href: "https://nomeda.tech" },
  { name: "Madar", src: "/logos/madar.svg", width: 220, height: 48, href: "https://madar.nomeda.tech" },
];

const worksWith = [
  { name: "Shopify", src: "/logos/shopify.svg", width: 24, height: 24, icon: true, label: "Shopify" },
  { name: "Meta / WhatsApp", src: "/logos/whatsapp.svg", width: 24, height: 24, icon: true, label: "Meta / WhatsApp" },
  { name: "Bosta", src: "/logos/bosta.png", width: 112, height: 32 },
  { name: "ShipBlu", src: "/logos/shipblu.png", width: 1967, height: 446 },
  { name: "J&T Express", src: "/logos/jnt.svg", width: 500, height: 105 },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Whano integrations | Shopify, Meta WhatsApp, Bosta, ShipBlu, J&T Express",
  description: "The systems Whano connects to, and the boundaries of each integration.",
  inLanguage: "ar",
  about: {
    "@type": "ItemList",
    itemListElement: [
      { "@type": "Organization", name: "Nomeda", url: "https://nomeda.tech" },
      { "@type": "SoftwareApplication", name: "Madar", url: "https://madar.nomeda.tech" },
      { "@type": "Thing", name: "Shopify" },
      { "@type": "Thing", name: "Meta WhatsApp Cloud API" },
      { "@type": "Thing", name: "Bosta" },
      { "@type": "Thing", name: "ShipBlu" },
      { "@type": "Thing", name: "J&T Express" },
    ],
  },
};
---

<Base
  title="Integrations | Shopify, Meta WhatsApp, Bosta, ShipBlu and J&T Express | Whano"
  titleArabic="التكاملات | Shopify وMeta WhatsApp وبوسطة وShipBlu وJ&T Express | Whano"
  description="Whano connects Shopify orders to Meta's WhatsApp Cloud API, and creates shipments with Bosta, ShipBlu, or J&T Express. See exactly what is connected and what is not."
  descriptionArabic="يربط Whano طلبات Shopify بواجهة WhatsApp Cloud API من Meta، وينشئ الشحنات مع بوسطة، أو ShipBlu، أو J&T Express. اعرف بالضبط ما هو متصل وما ليس متصلًا."
  schema={pageSchema}
>
  <Nav />
  <main id="main-content" class="about-page">
    <div class="site-frame">
      <header class="about-header reveal">
        <p class="eyebrow">
          <span data-copy="en">Whano / integrations</span>
          <span data-copy="ar" lang="ar">Whano / التكاملات</span>
        </p>
        <h1 class="about-title">
          <span data-copy="en">The tools you already use.</span>
          <span data-copy="ar" lang="ar">الأدوات التي تستخدمها بالفعل.</span>
        </h1>
        <p class="about-subtitle">
          <span data-copy="en">Whano connects a Shopify store to Meta's WhatsApp Cloud API and creates shipments with Bosta, ShipBlu, or J&T Express. Each store connects one carrier at a time. Nothing else is silently connected.</span>
          <span data-copy="ar" lang="ar">يربط Whano متجر Shopify بواجهة WhatsApp Cloud API من Meta، وينشئ الشحنات مع بوسطة، أو ShipBlu، أو J&T Express. وكل متجر يربط شركة شحن واحدة في كل مرة. ولا يوجد أي اتصال آخر بشكل مخفي.</span>
        </p>
      </header>

      <section class="works-with reveal" aria-labelledby="works-with-title">
        <div class="works-with__head">
          <p class="eyebrow">
            <span data-copy="en">Ecosystem</span>
            <span data-copy="ar" lang="ar">المنظومة</span>
          </p>
          <h2 class="works-with__title" id="works-with-title">
            <span data-copy="en">Built by Nomeda. Connected to your stack.</span>
            <span data-copy="ar" lang="ar">من إنتاج Nomeda، ومتصل بأدواتك.</span>
          </h2>
          <p class="works-with__note">
            <span data-copy="en">Whano is a Nomeda product. Its app guide runs on Madar. Shopify, Meta, and the carriers below are the integrations.</span>
            <span data-copy="ar" lang="ar">Whano منتج من Nomeda، ودليل تطبيقه يعمل على Madar. وShopify وMeta وشركات الشحن أدناه هي التكاملات.</span>
          </p>
        </div>

        <div class="works-with__row">
          <p class="works-with__label">
            <span data-copy="en">Built by Nomeda</span>
            <span data-copy="ar" lang="ar">من إنتاج Nomeda</span>
          </p>
          <ul class="works-with__logos">
            {nomedaProducts.map((item) => (
              <li class="works-with__item">
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <img
                    src={item.src}
                    alt={item.name}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="works-with__row">
          <p class="works-with__label">
            <span data-copy="en">Works with</span>
            <span data-copy="ar" lang="ar">يعمل مع</span>
          </p>
          <ul class="works-with__logos">
            {worksWith.map((item) => (
              <li class:list={["works-with__item", item.icon && "works-with__item--icon"]}>
                <img
                  src={item.src}
                  alt={item.name}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
                {item.label && <span class="works-with__label-text">{item.label}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="integration-grid" aria-label="Whano integrations">
        <article class="integration-card reveal">
          <div class="integration-card__brand">
            <img class="integration-card__logo integration-card__logo--icon" src="/logos/shopify.svg" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <p class="integration-card__label">Shopify</p>
          </div>
          <h2>
            <span data-copy="en">Orders and store data</span>
            <span data-copy="ar" lang="ar">الطلبات وبيانات المتجر</span>
          </h2>
          <p>
            <span data-copy="en">Shopify remains the source of order data. Whano reads the order, updates confirmation status, and writes back after a confirmed edit or cancellation.</span>
            <span data-copy="ar" lang="ar">يبقى Shopify مصدر بيانات الطلبات. يقرأ Whano الطلب، ويحدّث حالة التأكيد، ويكتب التغيير بعد تعديل أو إلغاء مؤكد.</span>
          </p>
          <a href={site.accessUrl.en} target="_blank" rel="noopener noreferrer">
            <span data-copy="en">Open the App Store listing</span>
            <span data-copy="ar" lang="ar">افتح صفحة التطبيق</span>
          </a>
        </article>

        <article class="integration-card reveal">
          <div class="integration-card__brand">
            <img class="integration-card__logo integration-card__logo--icon" src="/logos/whatsapp.svg" alt="" width="24" height="24" loading="lazy" decoding="async" />
            <p class="integration-card__label">Meta / WhatsApp</p>
          </div>
          <h2>
            <span data-copy="en">Official Cloud API</span>
            <span data-copy="ar" lang="ar">Cloud API الرسمية</span>
          </h2>
          <p>
            <span data-copy="en">Messages run on Meta's official WhatsApp Cloud API. Whano provisions the store number inside its WhatsApp Business Account, so the merchant does not need a Meta API account or a device.</span>
            <span data-copy="ar" lang="ar">تعمل الرسائل عبر WhatsApp Cloud API الرسمية من Meta. يوفّر Whano رقم المتجر داخل حساب WhatsApp Business الخاص به، فلا يحتاج التاجر إلى حساب Meta API أو جهاز.</span>
          </p>
          <a href="/security/">
            <span data-copy="en">How data is handled</span>
            <span data-copy="ar" lang="ar">كيف نتعامل مع البيانات</span>
          </a>
        </article>

        <article class="integration-card reveal">
          <div class="integration-card__brand">
            <img class="integration-card__logo" src="/logos/bosta.png" alt="" width="112" height="32" loading="lazy" decoding="async" />
            <p class="integration-card__label">Bosta</p>
          </div>
          <h2>
            <span data-copy="en">Shipping and tracking</span>
            <span data-copy="ar" lang="ar">الشحن والتتبع</span>
          </h2>
          <p>
            <span data-copy="en">Connect Bosta from the console. Whano creates the shipment after confirmation, follows its state, and shows the carrier's own exception reason. Pickup is available where Bosta supports it.</span>
            <span data-copy="ar" lang="ar">اربط بوسطة من لوحة التحكم. ينشئ Whano الشحنة بعد التأكيد، ويتابع حالتها، ويعرض سبب التعثر من شركة الشحن نفسها. ويتاح الاستلام حيث تدعمه بوسطة.</span>
          </p>
          <a href="/features/#order">
            <span data-copy="en">See the order flow</span>
            <span data-copy="ar" lang="ar">اطّلع على رحلة الطلب</span>
          </a>
        </article>

        <article class="integration-card reveal">
          <div class="integration-card__brand">
            <img class="integration-card__logo" src="/logos/shipblu.png" alt="" width="1967" height="446" loading="lazy" decoding="async" />
            <p class="integration-card__label">ShipBlu</p>
          </div>
          <h2>
            <span data-copy="en">A second carrier</span>
            <span data-copy="ar" lang="ar">شركة شحن ثانية</span>
          </h2>
          <p>
            <span data-copy="en">ShipBlu is connected the same way as Bosta: create the shipment, follow the state, and surface exceptions. The merchant chooses the carrier in the console.</span>
            <span data-copy="ar" lang="ar">يتم ربط ShipBlu بنفس طريقة بوسطة: إنشاء الشحنة، ومتابعة الحالة، وإظهار التعثرات. ويختار التاجر شركة الشحن من لوحة التحكم.</span>
          </p>
          <a href="/guides/shipping-readiness/">
            <span data-copy="en">Shipping readiness guide</span>
            <span data-copy="ar" lang="ar">دليل الاستعداد للشحن</span>
          </a>
        </article>

        <article class="integration-card integration-card--wide reveal">
          <div class="integration-card__brand">
            <img class="integration-card__logo" src="/logos/jnt.svg" alt="" width="500" height="105" loading="lazy" decoding="async" />
            <p class="integration-card__label">J&amp;T Express</p>
          </div>
          <h2>
            <span data-copy="en">A third carrier</span>
            <span data-copy="ar" lang="ar">شركة شحن ثالثة</span>
          </h2>
          <p>
            <span data-copy="en">Connect J&T Express with the store's customer code, password, and pickup profile. Whano creates the shipment after confirmation, follows J&T scans, and surfaces exceptions. A store keeps one carrier connection at a time.</span>
            <span data-copy="ar" lang="ar">اربط J&T Express بكود العميل وكلمة المرور وبيانات الاستلام الخاصة بالمتجر. ينشئ Whano الشحنة بعد التأكيد، ويتابع تحديثات J&T، ويعرض التعثرات. ويحتفظ المتجر بربط شركة شحن واحدة في كل مرة.</span>
          </p>
          <a href="/guides/bosta-vs-shipblu/">
            <span data-copy="en">How to choose a carrier</span>
            <span data-copy="ar" lang="ar">كيف تختار شركة الشحن</span>
          </a>
        </article>
      </section>

      <section class="about-section reveal" aria-labelledby="integration-boundaries">
        <h2 class="about-section__heading" id="integration-boundaries">
          <span data-copy="en">What is not connected</span>
          <span data-copy="ar" lang="ar">ما ليس متصلًا</span>
        </h2>
        <div class="about-section__body">
          <p>
            <span data-copy="en">Aramex and Mylerz are not live integrations. Payment processing is handled by Shopify or the store's existing checkout, not by Whano. Whano does not replace the storefront and does not create a separate multi-store console.</span>
            <span data-copy="ar" lang="ar">Aramex وMylerz ليسا تكاملين مباشرين. ومعالجة الدفع تتم عبر Shopify أو صفحة الدفع الحالية للمتجر، وليس عبر Whano. ولا يستبدل Whano واجهة المتجر، ولا ينشئ لوحة تحكم منفصلة لعدة متاجر.</span>
          </p>
          <p>
            <span data-copy="en">If a carrier or tool is not listed here, treat it as unsupported. A store can keep one carrier connection at a time, and switching is blocked while parcels from the old carrier are still moving. Ask support before promising a connection to a customer.</span>
            <span data-copy="ar" lang="ar">إذا كانت شركة الشحن أو الأداة غير مذكورة هنا، فاعتبرها غير مدعومة. ويمكن للمتجر الاحتفاظ بربط شركة شحن واحدة في كل مرة، ويكون التبديل محظورًا ما دامت شحنات الشركة القديمة في الطريق. اسأل الدعم قبل أن توعد عميلًا بربطها.</span>
          </p>
          <p class="contact-links">
            <a href="/contact/">
              <span data-copy="en">Ask about an integration</span>
              <span data-copy="ar" lang="ar">اسأل عن تكامل</span>
            </a>
            <a href="/pricing/">
              <span data-copy="en">See pricing</span>
              <span data-copy="ar" lang="ar">اطّلع على الأسعار</span>
            </a>
          </p>
        </div>
      </section>
    </div>
  </main>
  <CTA />
  <MobileCta />
  <Footer />
</Base>

<style>
  .works-with {
    display: grid;
    gap: 18px;
    margin: 26px 0 4px;
    padding: 24px;
    border: 1.5px solid var(--pl-line);
    border-radius: 22px;
    background: #fbf9ff;
  }

  .works-with__head {
    display: grid;
    max-width: 760px;
    justify-items: start;
    gap: 10px;
  }

  .works-with__title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .works-with__note {
    margin: 0;
    color: var(--ink-muted);
    font-size: 13px;
    line-height: 1.8;
  }

  .works-with__row {
    display: flex;
    align-items: center;
    gap: 18px;
    padding-top: 18px;
    border-top: 1.5px solid var(--pl-line);
  }

  .works-with__label {
    flex: 0 0 140px;
    margin: 0;
    color: var(--ink-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .works-with__logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .works-with__item {
    display: flex;
    height: 44px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 14px;
    border: 1.5px solid var(--pl-line);
    border-radius: 12px;
    background: #ffffff;
  }

  .works-with__item a {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .works-with__item img {
    display: block;
    width: auto;
    max-width: 104px;
    max-height: 22px;
    height: auto;
    object-fit: contain;
  }

  .works-with__item--icon img {
    max-width: 22px;
    max-height: 22px;
  }

  .works-with__label-text {
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  .integration-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 40px;
  }

  .integration-card {
    padding: 24px;
    border: 1.5px solid var(--pl-line);
    border-radius: 22px;
    background: #ffffff;
  }

  .integration-card--wide {
    grid-column: 1 / -1;
  }

  .integration-card__brand {
    display: flex;
    min-height: 34px;
    align-items: center;
    gap: 10px;
  }

  .integration-card__logo {
    display: block;
    width: auto;
    max-width: 150px;
    height: 30px;
    object-fit: contain;
  }

  .integration-card__logo--icon {
    width: 28px;
    height: 28px;
  }

  .integration-card--wide .integration-card__logo {
    height: 26px;
    max-width: 165px;
  }

  .integration-card__label {
    margin: 0;
    color: var(--green);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .integration-card h2 {
    margin: 10px 0 8px;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  .integration-card p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.8;
  }

  .integration-card a {
    display: inline-block;
    margin-top: 18px;
    color: var(--green);
    font-size: 12px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 22px;
    margin: 18px 0 0 !important;
  }

  .contact-links a {
    color: var(--green);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .works-with {
      padding: 20px;
    }

    .works-with__row {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .works-with__label {
      flex: none;
    }

    .works-with__logos {
      justify-content: flex-start;
    }

    .integration-grid {
      grid-template-columns: 1fr;
      margin-top: 20px;
    }

    .integration-card {
      padding: 20px;
    }
  }
</style>
