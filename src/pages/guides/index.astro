---
import Base from "../../layouts/Base.astro";
import CTA from "../../components/CTA.astro";
import Footer from "../../components/Footer.astro";
import MobileCta from "../../components/MobileCta.astro";
import Nav from "../../components/Nav.astro";
import { guides } from "../../data/guides";
---

<Base
  title="Guides — Whano"
  titleArabic="أدلة — Whano"
  description="Practical guides for Shopify stores running order follow-up on WhatsApp: what to send, when, and how to cut delivery questions."
  descriptionArabic="أدلة عملية لمتاجر Shopify التي تتابع طلباتها على واتساب: ماذا ترسل، ومتى، وكيف تقلّل أسئلة التوصيل."
>
  <Nav />
  <main id="main-content" class="about-page">
    <div class="site-frame">
      <header class="about-header reveal">
        <p class="eyebrow">
          <span data-copy="en">Whano / guides</span>
          <span data-copy="ar" lang="ar">Whano / أدلة</span>
        </p>
        <h1 class="about-title">
          <span data-copy="en">What to send, and when.</span>
          <span data-copy="ar" lang="ar">ماذا ترسل، ومتى.</span>
        </h1>
        <p class="about-subtitle">
          <span data-copy="en">Short, practical guides drawn from the flows Whano runs every day.</span>
          <span data-copy="ar" lang="ar">أدلة قصيرة وعملية مستمدة من المسارات التي يشغّلها Whano كل يوم.</span>
        </p>
      </header>

      <div class="guide-list">
        {guides.map((guide) => (
          <a href={`/guides/${guide.slug}`} class="guide-card reveal">
            <p class="guide-card__meta">
              <span data-copy="en">{guide.readingTime.en}</span>
              <span data-copy="ar" lang="ar">{guide.readingTime.ar}</span>
            </p>
            <h2 class="guide-card__title">
              <span data-copy="en">{guide.title.en}</span>
              <span data-copy="ar" lang="ar">{guide.title.ar}</span>
            </h2>
            <p class="guide-card__body">
              <span data-copy="en">{guide.description.en}</span>
              <span data-copy="ar" lang="ar">{guide.description.ar}</span>
            </p>
          </a>
        ))}
      </div>
    </div>
  </main>
  <CTA />
  <MobileCta />
  <Footer />
</Base>
