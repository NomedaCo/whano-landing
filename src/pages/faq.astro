---
import Base from "../layouts/Base.astro";
import { faqs, site } from "../data/content";
import Nav from "../components/Nav.astro";
import MobileCta from "../components/MobileCta.astro";
import Footer from "../components/Footer.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: "ar",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question.ar,
    acceptedAnswer: { "@type": "Answer", text: faq.answer.ar },
  })),
};
---

<Base
  title="Questions — WhatsApp automation for Shopify | Whano"
  titleArabic="الأسئلة — أتمتة واتساب لمتاجر Shopify | Whano"
  description="Practical answers about WhatsApp order confirmation, COD, carriers, points, and human handoff for Shopify merchants."
  descriptionArabic="إجابات عملية عن تأكيد الطلبات على واتساب، والدفع عند الاستلام، وشركات الشحن، والنقاط، وتسليم المحادثات لشخص."
  schema={faqSchema}
>
  <Nav />
  <main id="main-content" class="legal-page">
    <div class="site-frame">
      <header class="legal-header reveal">
        <p class="eyebrow">
          <span data-copy="en">Whano / questions</span>
          <span data-copy="ar" lang="ar">Whano / أسئلة</span>
        </p>
        <h1 class="legal-title">
          <span data-copy="en">{site.faq.title.en}</span>
          <span data-copy="ar" lang="ar">{site.faq.title.ar}</span>
        </h1>
        <p class="legal-meta">
          <span data-copy="en">{site.faq.body.en}</span>
          <span data-copy="ar" lang="ar">{site.faq.body.ar}</span>
        </p>
      </header>

      <div class="faq-list reveal" style="max-width: 740px;">
        {faqs.map((faq, index) => (
          <details class="faq-item" open={index === 0}>
            <summary class="faq-summary">
              <span data-copy="en">{faq.question.en}</span>
              <span data-copy="ar" lang="ar">{faq.question.ar}</span>
            </summary>
            <p class="faq-answer">
              <span data-copy="en">{faq.answer.en}</span>
              <span data-copy="ar" lang="ar">{faq.answer.ar}</span>
            </p>
          </details>
        ))}
      </div>
    </div>
  </main>
  <MobileCta />
  <Footer />

</Base>
