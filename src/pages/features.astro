---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import MobileCta from "../components/MobileCta.astro";
import { featureGroups, site } from "../data/content";
---

<Base
  title="Features — Whano"
  titleArabic="المزايا — Whano"
  description="Every automation Whano runs for a Shopify store: confirmations, order edits, shipping updates, ratings, returns, campaigns, reports, and the controls around them."
  descriptionArabic="كل أتمتة يشغّلها Whano لمتجر Shopify: التأكيدات، وتعديلات الطلبات، وتحديثات الشحن، والتقييمات، والاسترجاع، والحملات، والتقارير، ومفاتيح التحكم حولها."
>
  <Nav />
  <main id="main-content" class="about-page">
    <div class="site-frame">
      <header class="about-header reveal">
        <p class="eyebrow">
          <span data-copy="en">{site.featuresPage.eyebrow.en}</span>
          <span data-copy="ar" lang="ar">{site.featuresPage.eyebrow.ar}</span>
        </p>
        <h1 class="about-title">
          <span data-copy="en">{site.featuresPage.title.en}</span>
          <span data-copy="ar" lang="ar">{site.featuresPage.title.ar}</span>
        </h1>
        <p class="about-subtitle">
          <span data-copy="en">{site.featuresPage.body.en}</span>
          <span data-copy="ar" lang="ar">{site.featuresPage.body.ar}</span>
        </p>
      </header>

      <section class="console-band reveal" aria-hidden="true">
        <div class="console-preview">
          <div class="console-preview__top">
            <span class="console-preview__dot"></span>
            <span class="console-preview__dot"></span>
            <span class="console-preview__dot"></span>
            <span class="console-preview__url">whano.nomeda.tech/dashboard</span>
          </div>
          <div class="console-preview__body">
            <aside class="console-preview__side">
              <span class="console-preview__nav-item is-active"><i></i>
                <span data-copy="en">Overview</span><span data-copy="ar" lang="ar">نظرة عامة</span>
              </span>
              <span class="console-preview__nav-item"><i></i>
                <span data-copy="en">Orders</span><span data-copy="ar" lang="ar">الطلبات</span>
              </span>
              <span class="console-preview__nav-item"><i></i>
                <span data-copy="en">Shipments</span><span data-copy="ar" lang="ar">الشحنات</span>
              </span>
              <span class="console-preview__nav-item"><i></i>
                <span data-copy="en">Chats</span><span data-copy="ar" lang="ar">المحادثات</span>
              </span>
              <span class="console-preview__nav-item"><i></i>
                <span data-copy="en">Controls</span><span data-copy="ar" lang="ar">التحكم</span>
              </span>
              <span class="console-preview__nav-item"><i></i>
                <span data-copy="en">Reports</span><span data-copy="ar" lang="ar">التقارير</span>
              </span>
            </aside>
            <div class="console-preview__main">
              <div class="console-preview__kpis">
                <div class="console-preview__kpi">
                  <span data-copy="en">Revenue</span><span data-copy="ar" lang="ar">الإيرادات</span>
                  <b class="skeleton" style="width: 62%"></b>
                </div>
                <div class="console-preview__kpi">
                  <span data-copy="en">Confirmed orders</span><span data-copy="ar" lang="ar">الطلبات المؤكدة</span>
                  <b class="skeleton" style="width: 44%"></b>
                </div>
                <div class="console-preview__kpi">
                  <span data-copy="en">Messages delivered</span><span data-copy="ar" lang="ar">الرسائل المُسلَّمة</span>
                  <b class="skeleton" style="width: 74%"></b>
                </div>
              </div>
              <div class="console-preview__rows">
                <div class="console-preview__row">
                  <span>#1056</span><b class="skeleton" style="width: 55%"></b>
                  <em><span data-copy="en">Confirmed</span><span data-copy="ar" lang="ar">مؤكد</span></em>
                </div>
                <div class="console-preview__row">
                  <span>#1057</span><b class="skeleton" style="width: 68%"></b>
                  <em><span data-copy="en">In transit</span><span data-copy="ar" lang="ar">قيد النقل</span></em>
                </div>
                <div class="console-preview__row">
                  <span>#1058</span><b class="skeleton" style="width: 47%"></b>
                  <em><span data-copy="en">Delivered</span><span data-copy="ar" lang="ar">تم التوصيل</span></em>
                </div>
                <div class="console-preview__row">
                  <span>#1059</span><b class="skeleton" style="width: 60%"></b>
                  <em><span data-copy="en">Needs you</span><span data-copy="ar" lang="ar">يحتاجك</span></em>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {featureGroups.map((group) => (
        <section class="feature-group">
          <div class="feature-group__heading reveal">
            <h2 class="feature-group__title">
              <span data-copy="en">{group.title.en}</span>
              <span data-copy="ar" lang="ar">{group.title.ar}</span>
            </h2>
            <p class="feature-group__body">
              <span data-copy="en">{group.body.en}</span>
              <span data-copy="ar" lang="ar">{group.body.ar}</span>
            </p>
          </div>

          <div class="feature-grid">
            {group.items.map((item) => (
              <article class="feature-card reveal">
                <span class="feature-card__number">{item.number}</span>
                <h3 class="feature-card__title">
                  <span data-copy="en">{item.title.en}</span>
                  <span data-copy="ar" lang="ar">{item.title.ar}</span>
                </h3>
                <p class="feature-card__body">
                  <span data-copy="en">{item.body.en}</span>
                  <span data-copy="ar" lang="ar">{item.body.ar}</span>
                </p>
                <p class="feature-card__detail">
                  <span data-copy="en">{item.detail.en}</span>
                  <span data-copy="ar" lang="ar">{item.detail.ar}</span>
                </p>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <CTA />
  <MobileCta />
  <Footer />
</Base>
