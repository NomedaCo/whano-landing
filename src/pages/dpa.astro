---
import Base from "../layouts/Base.astro";
import LegalPage from "../components/LegalPage.astro";
import { dpaSections } from "../data/legal";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Data Processing Agreement",
  inLanguage: "ar",
  dateModified: "2026-10-24",
  description: "اتفاقية معالجة البيانات بين Whano والتجار.",
};
---

<Base
  schema={pageSchema}
  title="Data Processing Agreement | Whano" titleArabic="اتفاقية معالجة البيانات | Whano" description="The data processing agreement between Whano and merchants, effective on install." descriptionArabic="اتفاقية معالجة البيانات بين Whano والتجار، وتسري عند تثبيت التطبيق.">
  <LegalPage
    title={{ en: "Data Processing Agreement", ar: "اتفاقية معالجة البيانات" }}
    updated={{ en: "Last updated: October 24, 2026", ar: "آخر تحديث: 24 أكتوبر 2026" }}
    indexText={{ en: "Effective when you install Whano on your store.", ar: "تسري عند تثبيت Whano على متجرك." }}
    sections={dpaSections}
  />
</Base>
