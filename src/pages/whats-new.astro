---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import MobileCta from "../components/MobileCta.astro";
import Nav from "../components/Nav.astro";

// Real shipped changes, newest first. Nothing here is a roadmap: every entry
// is something a merchant can open the console and use today.
const UPDATES = [
  {
    when: { en: "Oct 23, 2026", ar: "23 أكتوبر 2026" },
    title: { en: "A bigger send buffer for busy days", ar: "سعة إرسال أكبر في الأيام المزدحمة" },
    body: {
      en: "The message queue now carries a thousand-message buffer, and a 250-message burst while the window warms up. Campaigns and order spikes wait their turn instead of failing.",
      ar: "طابور الرسائل أصبح يستوعب حتى ألف رسالة، مع دفعة أولية من 250 رسالة أثناء تجهيز النافذة. الحملات وموجات الطلبات تنتظر دورها بدل أن تفشل.",
    },
  },
  {
    when: { en: "Oct 23, 2026", ar: "23 أكتوبر 2026" },
    title: { en: "Campaigns, bulk audiences, and a real block list", ar: "حملات، وجمهور بالجملة، وقائمة حظر حقيقية" },
    body: {
      en: "Choose an audience by number of orders or total spend, add or remove customers in bulk, and keep a block list for unsubscribed or ignored customers. A campaign message costs 5 points.",
      ar: "اختر الجمهور حسب عدد الطلبات أو إجمالي الإنفاق، وأضف العملاء أو أزلهم دفعة واحدة، واحتفظ بقائمة حظر للمشتركين الملغين أو المتجاهلين. رسالة الحملة تكلّف 5 نقاط.",
    },
  },
  {
    when: { en: "Oct 23, 2026", ar: "23 أكتوبر 2026" },
    title: { en: "Abandoned cart reminders", ar: "تذكير بالسلة المتروكة" },
    body: {
      en: "When checkout stalls, Whano sends a reminder after the delay you set, within quiet hours and consent rules. Each reminder costs 4 points, or 5 with a campaign message.",
      ar: "عندما يتوقف الدفع، يرسل Whano تذكيرًا بعد المدة التي تحددها، ضمن ساعات الهدوء وقواعد الموافقة. كل تذكير يكلّف 4 نقاط، أو 5 مع رسالة حملة.",
    },
  },
  {
    when: { en: "Oct 21, 2026", ar: "21 أكتوبر 2026" },
    title: { en: "Size check is open to every store", ar: "فحص المقاس متاح لكل متجر" },
    body: {
      en: "Turn on size check in Controls. After confirmation, the customer enters height and weight once, and sees a size recommendation for every product with a size chart. The shipment waits until the check is done or expires.",
      ar: "فعّل فحص المقاس من التحكم. بعد التأكيد، يدخل العميل طوله ووزنه مرة واحدة، ويرى توصية مقاس لكل منتج له جدول مقاسات. وتنتظر الشحنة حتى ينتهي الفحص أو تنتهي مدته.",
    },
  },
  {
    when: { en: "Oct 20, 2026", ar: "20 أكتوبر 2026" },
    title: { en: "Size check tags in Shopify and the console", ar: "وسوم فحص المقاس في Shopify ولوحة التحكم" },
    body: {
      en: "Each size check now has a clear state: pending, changed, confirmed, no answer, or failed. The tag appears on the Shopify order and in the console, so nobody has to guess.",
      ar: "أصبح لكل فحص مقاس حالة واضحة: قيد الانتظار، أو تم التغيير، أو مؤكد، أو بلا رد، أو فشل. يظهر الوسم على طلب Shopify وفي لوحة التحكم، فلا يحتاج أحد إلى التخمين.",
    },
  },
  {
    when: { en: "Oct 20, 2026", ar: "20 أكتوبر 2026" },
    title: { en: "A review page with five optional stars", ar: "صفحة تقييم بخمس نجوم اختيارية" },
    body: {
      en: "The customer can leave a five-star rating and write a review on the order page. A low rating opens the exchange or refund path before it turns into a public review.",
      ar: "يمكن للعميل ترك تقييم بخمس نجوم وكتابة مراجعة من صفحة الطلب. والتقييم المنخفض يفتح مسار الاستبدال أو الاسترجاع قبل أن يتحول إلى مراجعة علنية.",
    },
  },
  {
    when: { en: "Oct 20, 2026", ar: "20 أكتوبر 2026" },
    title: { en: "Edit the order through a one-time link", ar: "تعديل الطلب عبر رابط لمرة واحدة" },
    body: {
      en: "The confirmation's Edit order button sends a secure link. The customer changes a quantity or variant or adds an item, sees the new total, and submits once before confirmation. Shopify stays in sync.",
      ar: "زر عدّل الطلب في التأكيد يرسل رابطًا آمنًا. يغيّر العميل الكمية أو المقاس أو يضيف منتجًا، ويرى الإجمالي الجديد، ويرسل التعديل مرة واحدة قبل التأكيد. ويبقى Shopify متزامنًا.",
    },
  },
  {
    when: { en: "Oct 17, 2026", ar: "17 أكتوبر 2026" },
    title: { en: "ShipBlu joins Bosta", ar: "انضمت ShipBlu إلى بوسطة" },
    body: {
      en: "Connect Bosta or ShipBlu from the console. Whano creates the shipment, follows its state, and handles pickup where the carrier supports it.",
      ar: "اربط بوسطة أو ShipBlu من لوحة التحكم. ينشئ Whano الشحنة، ويتابع حالتها، ويتعامل مع طلب الاستلام حيث تدعمه شركة الشحن.",
    },
  },
  {
    when: { en: "Oct 17, 2026", ar: "17 أكتوبر 2026" },
    title: { en: "Order status in your Google Sheet", ar: "حالة الطلب في Google Sheets" },
    body: {
      en: "The sheet export now includes status signs and the postal code, so the sheet reads like the order list you already use.",
      ar: "تصدير Google Sheets أصبح يتضمن علامات الحالة والرمز البريدي، ليقرأ الجدول مثل قائمة الطلبات التي تستخدمها بالفعل.",
    },
  },
  {
    when: { en: "Oct 15, 2026", ar: "15 أكتوبر 2026" },
    title: { en: "Choose the shape of every message", ar: "اختر شكل كل رسالة" },
    body: {
      en: "For each message that has more than one approved shape, choose whether it carries the order link, a rating page, or a reply. The manager previews the variables and button order before you save.",
      ar: "لكل رسالة لها أكثر من شكل معتمد، اختر هل تحمل رابط الطلب أو صفحة تقييم أو ردًا. وتعاين الإدارة المتغيرات وترتيب الأزرار قبل الحفظ.",
    },
  },
  {
    when: { en: "Oct 15, 2026", ar: "15 أكتوبر 2026" },
    title: { en: "The order update link works before confirmation", ar: "رابط تعديل الطلب يعمل قبل التأكيد" },
    body: {
      en: "The customer can edit quantities, remove an item, or add a new variant from one page. The link closes after one successful save, and the order stays pending until the customer confirms.",
      ar: "يمكن للعميل تعديل الكميات أو حذف منتج أو إضافة مقاس جديد من صفحة واحدة. يُغلق الرابط بعد حفظ ناجح واحد، ويبقى الطلب معلقًا حتى يؤكده العميل.",
    },
  },
  {
    when: { en: "Oct 15, 2026", ar: "15 أكتوبر 2026" },
    title: { en: "See where the points went", ar: "اعرف أين ذهبت النقاط" },
    body: {
      en: "The overview now shows the points spent per service for the selected period. Failed messages are netted out, so the number matches what actually ran.",
      ar: "تعرض النظرة العامة النقاط المستهلكة لكل خدمة في الفترة المحددة. وتُستبعد الرسائل الفاشلة، فالرقم يطابق ما تم تشغيله فعلًا.",
    },
  },
];
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Whano changelog",
  description:
    "The latest shipped Whano changes: send capacity, campaigns and audiences, abandoned carts, size check, review pages, the one-time edit link, ShipBlu, Sheets, and message shapes.",
  inLanguage: "ar",
  dateModified: "2026-10-27",
};
---

<Base
  title="What's new, Whano"
  titleArabic="ما الجديد, Whano"
  description="The latest shipped Whano changes: send capacity, campaigns and audiences, abandoned carts, size check, review pages, the one-time edit link, ShipBlu, Sheets, and message shapes."
  descriptionArabic="آخر ما أُطلق في Whano: سعة إرسال أكبر، وحملات وجمهور، والسلة المتروكة، وفحص المقاس، وصفحة التقييم، ورابط تعديل الطلب، وShipBlu، وGoogle Sheets، وأشكال الرسائل."
  ogImagePath="/og-whats-new.png"
  schema={pageSchema}
>
  <Nav />
  <main id="main-content" class="about-page">
    <div class="site-frame">
      <header class="about-header reveal">
        <p class="eyebrow">
          <span data-copy="en">Whano / what&apos;s new</span>
          <span data-copy="ar" lang="ar">Whano / ما الجديد</span>
        </p>
        <h1 class="about-title">
          <span data-copy="en">Shipped, not promised.</span>
          <span data-copy="ar" lang="ar">ما تم إطلاقه فعلًا.</span>
        </h1>
        <p class="about-subtitle">
          <span data-copy="en">Every entry here is live in the console today.</span>
          <span data-copy="ar" lang="ar">كل ما في هذه الصفحة متاح في لوحة التحكم اليوم.</span>
        </p>
      </header>

      <ol class="updates-list">
        {UPDATES.map((update) => (
          <li class="update-item reveal">
            <span class="update-item__when">
              <span data-copy="en">{update.when.en}</span>
              <span data-copy="ar" lang="ar">{update.when.ar}</span>
            </span>
            <h2 class="update-item__title">
              <span data-copy="en">{update.title.en}</span>
              <span data-copy="ar" lang="ar">{update.title.ar}</span>
            </h2>
            <p class="update-item__body">
              <span data-copy="en">{update.body.en}</span>
              <span data-copy="ar" lang="ar">{update.body.ar}</span>
            </p>
          </li>
        ))}
      </ol>
    </div>
  </main>
  <CTA />
  <MobileCta />
  <Footer />
</Base>
