---
import Base from "../layouts/Base.astro";
import LegalPage from "../components/LegalPage.astro";
import { privacySections } from "../data/legal";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy Policy",
  inLanguage: "ar",
  dateModified: "2026-10-24",
  description: "كيف يتعامل Whano مع بيانات المتجر والعملاء.",
};
---

<Base
  schema={pageSchema}
  title="Privacy Policy | Whano" titleArabic="سياسة الخصوصية | Whano" description="Privacy Policy for Whano, a WhatsApp automation service for Shopify merchants." descriptionArabic="سياسة خصوصية Whano، خدمة أتمتة التواصل على واتساب لمتاجر Shopify.">
  <LegalPage
    title={{ en: "Privacy Policy", ar: "سياسة الخصوصية" }}
    updated={{ en: "Last updated: October 24, 2026", ar: "آخر تحديث: 24 أكتوبر 2026" }}
    indexText={{ en: "How Whano handles store and customer data.", ar: "كيف يتعامل Whano مع بيانات المتجر والعملاء." }}
    sections={privacySections}
  />
</Base>
