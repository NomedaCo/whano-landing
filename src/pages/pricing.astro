---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import MobileCta from "../components/MobileCta.astro";
import Pricing from "../components/Pricing.astro";
import { plans, site } from "../data/content";

// The real offers, on the page they belong to. Built here because `Astro` is
// not in scope inside the inline-script expression at render time.
const pricingUrl = new URL("/pricing/", Astro.site).href;
const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Whano",
  description: site.pricing.body.ar,
  inLanguage: "ar",
  brand: { "@type": "Brand", name: "Whano" },
  url: pricingUrl,
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: 10,
    highPrice: 59,
    offerCount: 4,
    url: pricingUrl,
    offers: plans
      .filter((plan) => plan.priceUsd !== null)
      .map((plan) => ({
        "@type": "Offer",
        name: plan.name.ar,
        price: plan.priceUsd,
        priceCurrency: "USD",
        availability: "https://schema.org/InStock",
        url: pricingUrl,
      })),
  },
};
---

<Base
  title="Pricing — WhatsApp automation for Shopify | Whano"
  titleArabic="الأسعار — أتمتة واتساب لمتاجر Shopify | Whano"
  description="Whano runs on one-time points packs from 500 EGP ($10), billed in USD through Shopify. No monthly subscription, no automatic renewal, and points never expire."
  descriptionArabic="يعمل Whano بباقات نقاط تُدفع مرة واحدة بدءًا من 500 جنيه (10 دولارات)، وتُفوتر بالدولار عبر Shopify. من دون اشتراك شهري أو تجديد تلقائي، والنقاط لا تنتهي."
  ogImagePath="/og-pricing.png"
  schema={pricingSchema}
>
  <Nav />
  <main id="main-content">
    <div class="about-page">
      <div class="site-frame">
        <header class="about-header reveal">
          <p class="eyebrow">
            <span data-copy="en">{site.pricingPage.eyebrow.en}</span>
            <span data-copy="ar" lang="ar">{site.pricingPage.eyebrow.ar}</span>
          </p>
          <h1 class="about-title">
            <span data-copy="en">{site.pricingPage.title.en}</span>
            <span data-copy="ar" lang="ar">{site.pricingPage.title.ar}</span>
          </h1>
          <p class="about-subtitle">
            <span data-copy="en">{site.pricingPage.body.en}</span>
            <span data-copy="ar" lang="ar">{site.pricingPage.body.ar}</span>
          </p>
        </header>
      </div>
    </div>
    <Pricing />
    <CTA />
  </main>

  <MobileCta />
  <Footer />
</Base>
