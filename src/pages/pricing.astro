---
import Base from "../layouts/Base.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import MobileCta from "../components/MobileCta.astro";
import Pricing from "../components/Pricing.astro";
import { plans, site } from "../data/content";

// The real offers, on the page they belong to. Built here because `Astro` is
// not in scope inside the inline-script expression at render time.
const pricingUrl = new URL("/pricing/", Astro.site).href;
const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Whano",
  description: site.pricing.body.en,
  brand: { "@type": "Brand", name: "Whano" },
  url: pricingUrl,
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: 10,
    highPrice: 59,
    offerCount: 4,
    url: pricingUrl,
    offers: plans
      .filter((plan) => !("isEnterprise" in plan && plan.isEnterprise))
      .map((plan) => ({
        "@type": "Offer",
        name: plan.name.en,
        price: plan.price.en.replace("$", ""),
        priceCurrency: "USD",
        url: pricingUrl,
      })),
  },
};
---

<Base
  title="Pricing — Whano"
  titleArabic="الأسعار — Whano"
  description="Whano runs on points: buy a pack from $10, spend it across the automations you enable, and follow the balance in the console. No monthly subscription."
  descriptionArabic="يعمل Whano بالنقاط: اشترِ باقة تبدأ من 10 دولارات، واستخدمها في الأتمتات التي تفعّلها، وتابع الرصيد في لوحة التحكم. من دون اشتراك شهري."
  ogImagePath="/og-pricing.png"
>
  <Nav />
  <main id="main-content">
    <div class="about-page">
      <div class="site-frame">
        <header class="about-header reveal">
          <p class="eyebrow">
            <span data-copy="en">{site.pricingPage.eyebrow.en}</span>
            <span data-copy="ar" lang="ar">{site.pricingPage.eyebrow.ar}</span>
          </p>
          <h1 class="about-title">
            <span data-copy="en">{site.pricingPage.title.en}</span>
            <span data-copy="ar" lang="ar">{site.pricingPage.title.ar}</span>
          </h1>
          <p class="about-subtitle">
            <span data-copy="en">{site.pricingPage.body.en}</span>
            <span data-copy="ar" lang="ar">{site.pricingPage.body.ar}</span>
          </p>
        </header>
      </div>
    </div>
    <Pricing />
    <CTA />
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />
  <MobileCta />
  <Footer />
</Base>
