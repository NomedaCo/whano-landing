{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whano-landing",
  "main": "worker.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Every response passes through the Worker so the security, cache, and
    // font-CORS headers apply to HTML and assets as well as /api/*.
    "run_worker_first": ["/*"],
    // Serve the Astro 404.html for unknown routes instead of an empty edge 404.
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    {
      "binding": "ANALYTICS",
      "id": "b4ba17d4253543da853eb0858b319c68"
    }
  ]
}
